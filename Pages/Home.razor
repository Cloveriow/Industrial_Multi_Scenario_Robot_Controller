                        updateLaserAndPhotoelectricSensors: function () {
                            if (!this.eeBase || !this.laserBeamMesh) return;

                            this.scene.updateMatrixWorld(true);
                            const tcpWorldPos = new THREE.Vector3();
                            this.eeBase.getWorldPosition(tcpWorldPos);

                            const laserLength = Math.max(0.02, tcpWorldPos.y);
                            this.laserBeamMesh.scale.set(1, laserLength, 1);
                            this.laserBeamMesh.position.set(tcpWorldPos.x, tcpWorldPos.y - (laserLength / 2.0), tcpWorldPos.z);
