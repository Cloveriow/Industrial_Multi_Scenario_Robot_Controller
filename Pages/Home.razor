        e84Valid = false; e84Cs0 = false; e84TrReq = false; e84Busy = false;
        e84Comp = false; e84Ready = false;
        
        e84State = "E84_IDLE";

        await SetIRBeamState(false);
        await InvokeAsync(StateHasChanged);
    }

    private async Task SendHostCmdStartGrasp()
    {
        if (!await _simLock.WaitAsync(0)) return; 

        try
        {
            isExecutingTask = true;
            _cts?.Cancel();
            _cts = new CancellationTokenSource();

            LogSecs($"S2F41: Host Command 'STRESS_TEST' (Job: {currentJobId})", "host");
            LogSecs("S2F42: Command Acknowledge (HCACK=0)", "eq");
            gemControlState = "EXECUTING";

            if (activeScenario == 1)
            {
                await PlanAndGraspWithFullPhysics(_cts.Token);
            }
            else if (activeScenario == 2)
            {
                await RunScenario2RailTransfer();
            }
            else if (activeScenario == 3)
            {
                await RunScenario3ConveyorTracking();
            }
        }
        catch (OperationCanceledException)
        {
            LogSecs("⚠️ 任務收到取消訊號中斷", "alarm");
        }
        catch (Exception ex)
        {
            LogSecs($"🚨 任務執行例外安全捕捉: {ex.Message}", "alarm");
        }
        finally
        {
            isExecutingTask = false;
            _simLock.Release();
            await InvokeAsync(StateHasChanged);
        }
    }

