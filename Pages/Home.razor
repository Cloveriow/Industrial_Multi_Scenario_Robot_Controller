    public class ConstantVelocityKalman
    {
        private double y, v, p00 = 0.01, p01 = 0.0, p11 = 0.01;
        private readonly double qAcc;
        public ConstantVelocityKalman(double qAcc = 0.05) { this.qAcc = qAcc; }
        public double Position => y;
        public double Velocity => v;
        public double PredictAt(double dtAhead) => y + v * dtAhead;

        public void Reset(double y0, double v0) { y = y0; v = v0; p00 = 0.0004; p01 = 0.0; p11 = 0.0004; }

        public void Predict(double dt)
        {
            double n00 = p00 + 2 * dt * p01 + dt * dt * p11 + qAcc * dt * dt * dt / 3.0;
            double n01 = p01 + dt * p11 + qAcc * dt * dt / 2.0;
            double n11 = p11 + qAcc * dt;
            y += v * dt; p00 = n00; p01 = n01; p11 = n11;
        }
        public void UpdatePosition(double meas, double r)
        {
            double s = p00 + r, k0 = p00 / s, k1 = p01 / s, innov = meas - y;
            y += k0 * innov; v += k1 * innov;
            double n00 = (1 - k0) * p00, n01 = (1 - k0) * p01, n11 = p11 - k1 * p01;
            p00 = n00; p01 = n01; p11 = n11;
        }
        public void UpdateVelocity(double meas, double r)
        {
            double s = p11 + r, k0 = p01 / s, k1 = p11 / s, innov = meas - v;
            y += k0 * innov; v += k1 * innov;
            double n00 = p00 - k0 * p01, n01 = p01 - k0 * p11, n11 = (1 - k1) * p11;
            p00 = n00; p01 = n01; p11 = n11;
        }
    }

    private enum CellState { Idle, Waiting, Intercept, Sync, Picking, Transfer, Placing, Returning, Paused }
    private enum PickResult { Ok, Unreachable, Failed }
    private enum PartCheck { None, Ready, Missed }

    private sealed class CellConfig
    {
        public double PickWindowUpY = -0.60;      
        public double PickWindowDownY = 0.35;     
        public double StandbyY = -0.45;           
        public double StandbyZ = 0.30;            
        public double UpstreamMarginM = 0.05;     
        public double SyncTimeS = 0.45;           
        public double DescendTimeS = 0.45;        
        public double PinchTimeS = 0.25;          
        public double LiftTimeS = 0.30;           
        public double PlaceX = 0.0;               
        public double PlaceY = 0.75;
        public double PlaceZ = 0.14;
        public double SpeedScale = 1.0;           
        public int MaxRetry = 1;                  
        public double BeltASpeedNominal = 0.12;
    }
    private readonly CellConfig cfg = new CellConfig();

    private const double S3_PEAK_J1 = 120.0, S3_PEAK_J2 = 80.0, S3_PEAK_J3 = 120.0, S3_PEAK_J6 = 180.0;

    private readonly System.Diagnostics.Stopwatch _clock = System.Diagnostics.Stopwatch.StartNew();
    private double NowS => _clock.Elapsed.TotalSeconds;

    private ConstantVelocityKalman _kfY = new ConstantVelocityKalman(0.05);
    private bool _kfInit = false;
    private int _kfRejects = 0;
    private double _kfLastT = 0.0, _lastPacketS = -999.0;
    private long _partSerial = 0, _handledSerial = 0;
    private int _partSeq = 0;
    private double BeltV => _kfY.Velocity > 0.02 ? _kfY.Velocity : cfg.BeltASpeedNominal;
    private double PredictY(double tAbs) => _kfY.PredictAt(tAbs - _kfLastT);

    private CellState cellState = CellState.Idle;
    private volatile bool _pauseReq, _stopReq;
    private CancellationTokenSource _cellCts;
    private Task _cellTask = Task.CompletedTask;
    private int cellPicked, cellMissed, cellSkipped, cellAlarms, _activeAlid;
    private double _runStartS, _trackErrMm, _lastCycleS;
    private double Uph => cellPicked * 3600.0 / Math.Max(1.0, NowS - _runStartS);

    private string E10Category => cellState switch
    {
        CellState.Idle => "STANDBY",
        CellState.Waiting => "STANDBY",
