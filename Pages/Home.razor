@page "/"
@using Microsoft.JSInterop
@using System.Globalization
@using System.Threading
@using System.Threading.Tasks
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="ros2-sim-wrapper">
    <!-- 主 3D 模擬與控制面板區塊 -->
    <div class="ros2-sim-container">
        <div class="canvas-section">
            <div id="ros2-canvas" class="canvas-area"></div>
            <div class="overlay-info">
                <span class="badge ros-badge">Scenario: @activeScenarioName</span>
                <span class="badge-topic">Planner: @plannerStatus</span>
            </div>
            <!-- 🖱️ 左下角滑鼠 3D 世界座標顯示區 -->
            <div class="overlay-bottom-left">
                <span id="mouse-coords" class="badge-topic mouse-badge">World Coordinates (Z-Up): (X: 0.000, Y: 0.000, Z: 0.000)m</span>
            </div>
        </div>

        <div class="control-section">
            <div class="panel-header">
                <h2>Station Controller - SEMI E30 SECS/GEM</h2>
                <p>SEMI E84 Cleanroom | 7-DOF Linear Rail | Conveyor Tracking Cell</p>
            </div>

            <!-- 🎛️ 情境切換頁籤 -->
            <div class="scenario-tabs">
                <button class="@(activeScenario == 1 ? "tab-btn active" : "tab-btn")" @onclick="() => SwitchScenario(1)">1. SEMI E84 Wafer</button>
                <button class="@(activeScenario == 2 ? "tab-btn active" : "tab-btn")" @onclick="() => SwitchScenario(2)">2. 7-DOF Rail</button>
                <button class="@(activeScenario == 3 ? "tab-btn active" : "tab-btn")" @onclick="() => SwitchScenario(3)">3. Conveyor Tracking</button>
            </div>

            <hr />

            <!-- 🚥 情境 1 專用：SEMI E84 PI/O 硬體信號燈號 -->
            @if (activeScenario == 1)
            {
                <div class="e84-signal-box">
                    <div class="e84-title">SEMI E84 PI/O Signal Status</div>
                    <div class="e84-grid">
                        <div class="@GetE84Class(e84Valid)">VALID</div>
                        <div class="@GetE84Class(e84Cs0)">CS_0</div>
                        <div class="@GetE84Class(e84TrReq)">TR_REQ</div>
                        <div class="@GetE84Class(e84Busy)">BUSY</div>
                        <div class="@GetE84Class(e84Comp)">COMP</div>
                        <div class="@GetE84Class(e84LReq, "active-passive")">L_REQ</div>
                        <div class="@GetE84Class(e84Ready, "active-passive")">READY</div>
                        <div class="@GetE84Class(e84HoAvbl, "active-passive")">HO_AVBL</div>
                    </div>
                </div>

                <div class="ik-input-box">
                    <h4>Host Commands (S2F41)</h4>
                    <div class="host-btn-grid">
                        <button class="btn-sec-cmd" @onclick="SendHostCmdStartGrasp" style="background:#d90429;" disabled="@isExecutingTask">▶ TRANSFER_REQ</button>
                        <button class="btn-sec-cmd" @onclick="SendHostCmdRetract">↩ RETRACT</button>
                    </div>
                    <button class="btn-scramble" style="margin-top:5px;" @onclick="RandomizeScene">↻ INIT SCENARIO</button>
                </div>
            }
            else if (activeScenario == 2)
            {
                <!-- 🚊 情境 2 專用：7-DOF 橫向導軌控制面板 -->
                <div class="ik-input-box">
                    <h4>Multi-Station Transfer Control</h4>
                    <div class="host-btn-grid">
                        <button class="btn-sec-cmd" @onclick="SendHostCmdStartGrasp" style="background:#007acc;" disabled="@isExecutingTask">▶ EXECUTE TRANSFER</button>
                        <button class="btn-sec-cmd" @onclick="SendHostCmdRetract">🏠 RETURN TO HOME</button>
                    </div>
                    <div class="debug-row" style="margin-top:4px;"><b>Rail X Position:</b> <span style="color:#00ffcc; font-weight:bold;">@xRailPos.ToString("F3") m</span></div>
                    <button class="btn-scramble" style="margin-top:5px;" @onclick="RandomizeScene">↻ INIT SCENARIO</button>
                </div>
            }
            else if (activeScenario == 3)
            {
                <!-- 🏭 情境 3 專用：SECS/GEM 輸送帶追蹤製程單元 -->
                <div class="ik-input-box">
                    <h4>Conveyor Cell Control</h4>
                    <div class="host-btn-grid">
                        <button class="btn-sec-cmd" style="background:#28a745;" @onclick='() => Scenario3HostCmd("START")'>▶ START</button>
                        <button class="btn-sec-cmd" @onclick='() => Scenario3HostCmd(_pauseReq ? "RESUME" : "PAUSE")'>@(_pauseReq ? "▶ RESUME" : "⏸ PAUSE")</button>
                    </div>
                    <div class="host-btn-grid">
                        <button class="btn-sec-cmd" @onclick='() => Scenario3HostCmd("STOP")'>⏹ STOP</button>
                        <button class="btn-sec-cmd" style="background:#d90429;" @onclick='() => Scenario3HostCmd("ABORT")'>⛔ ABORT</button>
                    </div>
                    <div class="debug-row"><b>Process State:</b> <span style="color:#00ffcc">@cellState</span> (E10: @E10Category)</div>
                    <div class="debug-row"><b>Belt Speed (EKF):</b> <span style="color:#00ffcc">@_kfY.Velocity.ToString("F3") m/s</span></div>
                    <div class="debug-row"><b>Yield (Pick/Skip/Miss):</b> @cellPicked / @cellSkipped / @cellMissed &nbsp; <b>ALM:</b> @cellAlarms</div>
                    <div class="debug-row"><b>UPH:</b> <span style="color:#ffb703">@Uph.ToString("F0")</span> &nbsp; <b>CT:</b> @_lastCycleS.ToString("F2") s &nbsp; <b>Sync Err:</b> @_trackErrMm.ToString("F1") mm</div>
                </div>
            }

            <!-- 實時參數與感測器監控面板 -->
            <div class="debug-panel">
                <div class="debug-row"><b>Control State:</b> <span style="color:#00d2ff">@gemControlState</span></div>
                <div class="debug-row"><b>Adaptive TCP Z-Offset:</b> <span style="color:#00ffcc; font-weight:bold;">@adaptiveL_TCP.ToString("F4") m</span></div>
                <div class="debug-row"><b>Admittance Z-Yield:</b> <span style="color:#ffb703; font-weight:bold;">@admittanceOffsetZ.ToString("F4") m</span></div>
                <div class="debug-row"><b>RGB-D EKF Pose:</b> <span style="color:#ffb703">(<span style="color:#00d2ff">@estX.ToString("F3")</span>, <span style="color:#00d2ff">@estY.ToString("F3")</span>, <span style="color:#00d2ff">@estZ.ToString("F3")</span>) Yaw:<span style="color:#00d2ff">@estYaw.ToString("F1")°</span></span></div>
                <div class="debug-row"><b>Tactile Pressure:</b> <span style="color:#28a745">L: @pressureLeft.ToString("F1") / R: @pressureRight.ToString("F1") kPa</span></div>
                <div class="debug-row highlight"><b>Forward Kinematics TCP:</b> (<span style="color:#00ffcc">@fkTcpX.ToString("F3")</span>, <span style="color:#00ffcc">@fkTcpY.ToString("F3")</span>, <span style="color:#00ffcc">@fkTcpZ.ToString("F3")</span>)</div>
                <div class="debug-row"><b>Encoders (J1-J6):</b> @encJ1.ToString("F0")° / @encJ2.ToString("F0")° / @encJ3.ToString("F0")° / @encJ4.ToString("F0")° / @encJ5.ToString("F0")° / @encJ6.ToString("F0")°</div>
                <div class="debug-row"><b>Diagnostics:</b> @diagnosticMessage</div>
            </div>

            <!-- 📜 SECS-II / Transfer Log Console -->
            <div class="sec-console" style="height: 160px;">
                <div class="console-title">SECS-II Event Log</div>
                <div class="console-body">
                    @foreach (var log in secsLogs)
                    {
                        <div class="console-line @log.StyleClass">@log.Text</div>
                    }
                </div>
            </div>

            <div class="@GraspStatusClass" style="margin-top: 6px;">
                <span>Status: <b>@(isTransferDone ? "✅ SEQUENCE COMPLETED" : "⏳ AWAITING COMMAND")</b></span>
            </div>
        </div>
    </div>

    <!-- 📷 512x512 高解析度第一人稱視野 HUD -->
    <div class="rgbd-preview-container">
        <div class="rgbd-header">
            <span>Eye-in-Hand RGB-D Vision System</span>
            <span class="rgbd-status">LIVE STREAM | 30 FPS</span>
        </div>
        <div class="rgbd-viewport">
            <div id="rgbd-canvas" class="rgbd-canvas-area"></div>
            <div class="sensor-noise-overlay"></div>
            <div class="sensor-scanlines"></div>
            <div class="rgbd-hud-overlay">
                <div class="hud-crosshair-v"></div>
                <div class="hud-crosshair-h"></div>
                <div class="hud-box"></div>
                <span class="hud-tag top-left">FOV: 60°</span>
                <span class="hud-tag top-right">RES: 512x512</span>
                <span class="hud-tag bottom-left">TCP ALIGN</span>
                <span class="hud-tag bottom-right">Z-DIST: @tofLaserDist.ToString("F3")m</span>
            </div>
        </div>
    </div>
</div>

<style>
    .ros2-sim-wrapper { display: flex; flex-direction: column; gap: 16px; width: 100%; }
    .ros2-sim-container { display: flex; width: 100%; height: 720px; background-color: #1a1a1e; font-family: 'Segoe UI', Roboto, sans-serif; color: #e0e0e0; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.6); }
    .canvas-section { flex: 1; position: relative; height: 100%; }
    .canvas-area { width: 100%; height: 100%; }
    .overlay-info { position: absolute; top: 15px; left: 15px; display: flex; gap: 8px; pointer-events: none; }
    .overlay-bottom-left { position: absolute; bottom: 15px; left: 15px; display: flex; gap: 8px; pointer-events: none; }
    .mouse-badge { border-color: #00ffccaa !important; color: #00ffcc !important; background: rgba(10, 10, 15, 0.85) !important; font-family: 'Consolas', monospace; transition: color 0.1s; }
    .badge { background: #28a745; color: white; padding: 4px 10px; border-radius: 4px; font-size: 12px; font-weight: bold; }
    .badge-topic { background: rgba(0,0,0,0.7); color: #00d2ff; padding: 4px 10px; border-radius: 4px; font-size: 12px; border: 1px solid #00d2ff44; }
    .control-section { width: 390px; padding: 14px; background: #222228; border-left: 1px solid #333; display: flex; flex-direction: column; gap: 8px; box-sizing: border-box; }
    .panel-header h2 { margin: 0; font-size: 15px; color: #00d2ff; }
    .panel-header p { margin: 2px 0 0 0; font-size: 10px; color: #888; }
    .scenario-tabs { display: flex; gap: 4px; background: #121215; padding: 4px; border-radius: 6px; border: 1px solid #333; }
    .tab-btn { flex: 1; padding: 6px 2px; background: #222; color: #aaa; border: none; border-radius: 4px; font-size: 10px; font-weight: bold; cursor: pointer; transition: all 0.2s; }
    .tab-btn.active { background: #007acc; color: #fff; box-shadow: 0 0 8px rgba(0, 122, 204, 0.6); }
    .e84-signal-box { background: #121215; border: 1px solid #333; border-radius: 6px; padding: 6px; }
    .e84-title { font-size: 10px; color: #00d2ff; font-weight: bold; margin-bottom: 4px; }
    .e84-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; }
    .e84-item { background: #222; color: #555; font-size: 9px; font-family: monospace; padding: 3px 0; text-align: center; border-radius: 3px; border: 1px solid #333; font-weight: bold; }
    .e84-item.active { background: #007acc; color: #fff; border-color: #00d2ff; box-shadow: 0 0 6px rgba(0, 210, 255, 0.6); }
    .e84-item.active-passive { background: #28a745; color: #fff; border-color: #28a745; box-shadow: 0 0 6px rgba(40, 167, 69, 0.6); }
    .ik-input-box { background: #151518; padding: 6px; border-radius: 6px; border: 1px solid #00d2ff44; display: flex; flex-direction: column; gap: 4px; }
    .ik-input-box h4 { margin: 0; font-size: 10px; color: #00d2ff; }
    .host-btn-grid { display: flex; gap: 6px; }
    .btn-sec-cmd { flex: 1; padding: 6px; background: #007acc; color: white; border: none; border-radius: 4px; font-size: 10px; font-weight: bold; cursor: pointer; }
    .btn-sec-cmd:hover { background: #005999; }
    .btn-sec-cmd:disabled { background: #444; cursor: not-allowed; }
    .btn-scramble { width: 100%; padding: 6px; background: #ff9d00; color: black; border: none; border-radius: 4px; font-weight: bold; font-size: 10px; cursor: pointer; }
    .btn-scramble:hover { background: #e08b00; }
    .debug-panel { background: #121214; padding: 6px; border-radius: 6px; border: 1px solid #333; font-size: 10px; display: flex; flex-direction: column; gap: 3px; }
    .debug-row.highlight { color: #ffb703; }
    .sec-console { background: #0a0a0c; border: 1px solid #333; border-radius: 6px; display: flex; flex-direction: column; overflow: hidden; }
    .console-title { background: #18181c; padding: 3px 6px; font-size: 9px; color: #00d2ff; font-weight: bold; border-bottom: 1px solid #222; }
    .console-body { flex: 1; padding: 4px; font-family: 'Consolas', 'Courier New', monospace; font-size: 9px; overflow-y: auto; display: flex; flex-direction: column; gap: 2px; }
    .console-line { line-height: 1.2; }
    .console-line.host { color: #00ffcc; }
    .console-line.eq { color: #ffb703; }
    .console-line.alarm { color: #ff0055; font-weight: bold; }
    .grasp-status-box { background: #151518; padding: 6px; border-radius: 6px; border: 1px solid #444; font-size: 10px; text-align: center; }
    .grasp-status-box.grasped { background: rgba(40, 167, 69, 0.2); border-color: #28a745; color: #28a745; }
    .rgbd-preview-container { width: 100%; background: #121215; border: 1px solid #00d2ff44; border-radius: 12px; padding: 10px; box-sizing: border-box; box-shadow: 0 6px 20px rgba(0,0,0,0.5); }
    .rgbd-header { display: flex; justify-content: space-between; align-items: center; font-size: 12px; font-weight: bold; color: #00d2ff; margin-bottom: 8px; padding-bottom: 4px; border-bottom: 1px solid #222228; }
    .rgbd-status { font-size: 10px; color: #28a745; font-family: monospace; }
    .rgbd-viewport { position: relative; width: 100%; max-width: 512px; height: 512px; margin: 0 auto; background: #000; border-radius: 8px; overflow: hidden; border: 1px solid #333; }
    .rgbd-canvas-area { width: 100%; height: 100%; }
    .sensor-noise-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; opacity: 0.12; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E"); animation: sensorGrain 0.08s infinite alternate; }
    .sensor-scanlines { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03)); background-size: 100% 4px, 6px 100%; opacity: 0.7; }
    @@keyframes sensorGrain { 0% { transform: translate(0, 0); } 50% { transform: translate(-1px, 1px); } 100% { transform: translate(1px, -1px); } }
    .rgbd-hud-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; }
    .hud-crosshair-v { position: absolute; top: 0; left: 50%; width: 1px; height: 100%; background: rgba(0, 255, 204, 0.25); }
    .hud-crosshair-h { position: absolute; top: 50%; left: 0; width: 100%; height: 1px; background: rgba(0, 255, 204, 0.25); }
    .hud-box { position: absolute; top: 35%; left: 35%; width: 30%; height: 30%; border: 1px dashed rgba(0, 255, 204, 0.5); border-radius: 4px; }
    .hud-tag { position: absolute; font-family: monospace; font-size: 9px; color: #00ffcc; background: rgba(0,0,0,0.6); padding: 2px 5px; border-radius: 3px; }
    .hud-tag.top-left { top: 8px; left: 8px; }
    .hud-tag.top-right { top: 8px; right: 8px; color: #00d2ff; }
    .hud-tag.bottom-left { bottom: 8px; left: 8px; }
    .hud-tag.bottom-right { bottom: 8px; right: 8px; color: #ffb703; }
</style>

@code {
    public class ExtendedKalmanFilter1D
    {
        private readonly double q = 0.0002;
        private readonly double r = 0.0015;
        private double x = 0, p = 0.01, k = 0;

        public ExtendedKalmanFilter1D(double initValue) { x = initValue; p = 0.01; k = 0; }
        public double Update(double measurement)
        {
            if (Math.Abs(measurement - x) > 0.15)
            {
                x = measurement;
                p = 0.01;
                return x;
            }

            p += q; k = p / (p + r);
            x += k * (measurement - x);
            p = (1.0 - k) * p;
            return x;
        }
        public void Reset(double initValue) { x = initValue; p = 0.01; k = 0; }
    }

    private readonly struct KinematicGuardLimits
    {
        public double MaxJointVelocity { get; init; }
        public double MaxJointAcceleration { get; init; }
        public double MaxAngleJumpPerFrame { get; init; }
        public double GearboxBacklashDeg { get; init; }

        public static KinematicGuardLimits Default => new KinematicGuardLimits
        {
            MaxJointVelocity = 150.0,
            MaxJointAcceleration = 300.0,
            MaxAngleJumpPerFrame = 3.0,
            GearboxBacklashDeg = 0.05
        };
    }

    private static readonly KinematicGuardLimits _kinematicLimits = KinematicGuardLimits.Default;

    private const double GRAVITY = 9.81;
    private const double FRICTION_MU = 0.65;
    private const double M1 = 3.0, M2 = 2.0, M3 = 1.2, M_EE = 0.8, M_BOX = 0.35;
    private const double L1 = 0.8, L2 = 0.6, L_TCP_NOMINAL = 0.22;
    private const double SHOULDER_Z = 1.0;
    private const double SOLID_GRIP_LIMIT = 0.118;
    private const double GROUND_Z = 0.06;
    private const double MIN_OVERLAP_RATIO_LIMIT = 0.65;
    private const double MAX_TIPPING_TORQUE_LIMIT = 0.15;
    private const double NORMAL_FORCE_SOLID = 12.0;

    private const double FAB_HOME_J1 = 0.0;
    private const double FAB_HOME_J2 = -65.0;
    private const double FAB_HOME_J3 = 130.0;
    private const double FAB_HOME_J4 = 25.0;
    private const double FAB_HOME_J5 = 0.0;
    private const double FAB_HOME_J6 = 0.0;
    private const double FAB_HOME_GRIP = 0.24;

    private const double ADMITTANCE_M = 0.5;
    private const double ADMITTANCE_B = 45.0;
    private const double ADMITTANCE_K = 220.0;
    private const double DESIRED_CONTACT_FORCE = 12.0;

    private readonly SemaphoreSlim _simLock = new SemaphoreSlim(1, 1);
    private CancellationTokenSource _cts;
    private DateTime _lastUiRenderTime = DateTime.MinValue;
    private const int UI_RENDER_INTERVAL_MS = 33;

    private bool isExecutingTask = false;

    private int activeScenario = 1;
    private string activeScenarioName => activeScenario switch {
        1 => "SEMI E84 Wafer Handling",
        2 => "7-DOF Linear Rail Station",
        3 => "Conveyor Tracking Cell",
        _ => "Unknown"
    };

    private double xRailPos = 0.0;

    private double adaptiveL_TCP = L_TCP_NOMINAL;
    private double adaptiveGroundZ = GROUND_Z;
    private double activePayloadMass = 0.0;

    private string plannerStatus = "IDLE";
    private string gemControlState = "REMOTE";
    private string boxPhysicsStatus = "Grounded";
    private string diagnosticMessage = "System Ready. Awaiting Host Command.";
    private string overlapStatus = "SAFE";
    private string currentJobId = "JOB_WFR_001";

    private string e84State = "E84_IDLE";
    private bool e84Valid = false, e84Cs0 = false, e84TrReq = false, e84Busy = false, e84Comp = false, e84Ready = false;
    private bool e84HoAvbl = true, e84LReq = true;
    private bool isIRBeamOn = false;

    private double realX = 0.25, realY = 0.75, realZ = GROUND_Z;
    private double boxRotX = 0, boxRotY = 0, boxRotZ = 0;

    private double admittanceOffsetZ = 0.0;
    private double admittanceVelZ = 0.0;

    private double tofLaserDist = 0.0;
    private bool isPhotoelectricBroken = false;
    private double pressureLeft = 0.0, pressureRight = 0.0;
    private double encJ1 = 0, encJ2 = 0, encJ3 = 0, encJ4 = 0, encJ5 = 0, encJ6 = 0;
    private double estX = 0.25, estY = 0.75, estZ = GROUND_Z, estYaw = 0.0;

    private double fkTcpX = 0.0, fkTcpY = 0.0, fkTcpZ = 0.0;
    private double compOffsetX = 0.0, compOffsetY = 0.0;
    private double realDist = 99.0;
    private double eeTipZ = 0;

    private double overlapRatio = 1.0;
    private double tippingTorque = 0.0;

    private double j1Angle = FAB_HOME_J1;
    private double j2Angle = FAB_HOME_J2;
    private double j3Angle = FAB_HOME_J3;
    private double j4Angle = FAB_HOME_J4;
    private double j5Angle = FAB_HOME_J5;
    private double j6Angle = FAB_HOME_J6;
    private double gripperDist = FAB_HOME_GRIP;

    private double w1 = 0, w2 = 0, w3 = 0, w4 = 0, w5 = 0, w6 = 0;

    private double tauJ1 = 0, tauJ2 = 0, tauJ3 = 0;
    private double tauCoriolis = 0.0;
    private double normalForce = 0.0, frictionForce = 0.0;

    private bool isGrasped = false;
    private bool isTransferDone = false;
    private bool isResetting = false;
    private IDisposable objRef;
    private Random random = new Random();

    public readonly struct SensorBusPacket
    {
        public double RgbdX { get; init; }
        public double RgbdY { get; init; }
        public double RgbdZ { get; init; }
        public double RgbdYaw { get; init; }
        public double LaserDist { get; init; }
        public bool IsBeamBroken { get; init; }
        public double PressureL { get; init; }
        public double PressureR { get; init; }
        public double Enc1 { get; init; }
        public double Enc2 { get; init; }
        public double Enc3 { get; init; }
        public double Enc4 { get; init; }
        public double Enc5 { get; init; }
        public double Enc6 { get; init; }
        public double OverlapRatio { get; init; }
        public double BeltSpeed { get; init; }
    }

    private readonly struct SecsLog
    {
        public string Text { get; }
        public string StyleClass { get; }

        public SecsLog(string text, string styleClass)
        {
            Text = text;
            StyleClass = styleClass;
        }
    }

    private readonly struct JointState
    {
        public double J1 { get; init; }
        public double J2 { get; init; }
        public double J3 { get; init; }
        public double J4 { get; init; }
        public double J5 { get; init; }
        public double J6 { get; init; }
        public double Grip { get; init; }
    }

    private List<SecsLog> secsLogs = new List<SecsLog>();

    private ExtendedKalmanFilter1D ekfX = new ExtendedKalmanFilter1D(-0.75);
    private ExtendedKalmanFilter1D ekfY = new ExtendedKalmanFilter1D(-0.20);
    private ExtendedKalmanFilter1D ekfZ = new ExtendedKalmanFilter1D(0.14);
    private ExtendedKalmanFilter1D ekfYaw = new ExtendedKalmanFilter1D(0.0);

    private string GetE84Class(bool isActive, string activeClass = "active")
    {
        return isActive ? $"e84-item {activeClass}" : "e84-item";
    }

    private string GraspStatusClass => isTransferDone ? "grasp-status-box grasped" : "grasp-status-box";

    private void LogSecs(string text, string style = "eq")
    {
        string line = $"[{DateTime.Now:HH:mm:ss}] {text}";
        _ = InvokeAsync(() =>
        {
            secsLogs.Add(new SecsLog(line, style));
            if (secsLogs.Count > 400) secsLogs.RemoveAt(0);
            StateHasChanged();
        });
    }

    private static double ApplyKinematicSpeedGuard(double current, double target, double maxStep)
    {
        double diff = target - current;
        return current + Math.Clamp(diff, -maxStep, maxStep);
    }

    private async Task SwitchScenario(int scenarioId)
    {
        if (activeScenario == scenarioId) return;

        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        try
        {
            isResetting = true;
            activeScenario = scenarioId;

            secsLogs.Clear();

            isTransferDone = false;
            isGrasped = false;
            isExecutingTask = false;
            xRailPos = 0.0;

            adaptiveL_TCP = L_TCP_NOMINAL;
            adaptiveGroundZ = GROUND_Z;
            admittanceOffsetZ = 0.0;
            admittanceVelZ = 0.0;
            activePayloadMass = 0.0;

            compOffsetX = 0.0;
            compOffsetY = 0.0;
            w1 = 0; w2 = 0; w3 = 0; w4 = 0; w5 = 0; w6 = 0;
            normalForce = 0.0; frictionForce = 0.0; tippingTorque = 0.0;

            j1Angle = FAB_HOME_J1;
            j2Angle = FAB_HOME_J2;
            j3Angle = FAB_HOME_J3;
            j4Angle = FAB_HOME_J4;
            j5Angle = FAB_HOME_J5;
            j6Angle = FAB_HOME_J6;
            gripperDist = FAB_HOME_GRIP;

            encJ1 = FAB_HOME_J1; encJ2 = FAB_HOME_J2; encJ3 = FAB_HOME_J3;
            encJ4 = FAB_HOME_J4; encJ5 = FAB_HOME_J5; encJ6 = FAB_HOME_J6;

            plannerStatus = "STANDBY";
            gemControlState = "REMOTE";
            boxPhysicsStatus = "Grounded";
            overlapRatio = 1.0;
            overlapStatus = "SAFE";

            _kfInit = false; _partSerial = 0; _handledSerial = 0;
            _pauseReq = false; _stopReq = false;
            cellState = CellState.Idle;

            await ClearE84Signals();
            await JSRuntime.InvokeVoidAsync("ros2SwitchScenario", scenarioId);

            LogSecs($"S6F11 CEID=1000 (Equipment_Constant_Changed)", "eq");
            diagnosticMessage = $"Scenario switched to {activeScenarioName}. Parameters reset.";

            await RandomizeScene();

            if (scenarioId == 3)
            {
                LogSecs("Scenario 3 Ready. Awaiting S2F41 START.", "host");
            }
        }
        finally
        {
            isResetting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void LogDetailedFailureDiagnostics(string failureStage)
    {
        double calculatedWorldYaw = encJ1 - encJ6;
        double deltaX = fkTcpX - estX;
        double deltaY = fkTcpY - estY;
        double deltaZ = fkTcpZ - estZ;
        double yawError = calculatedWorldYaw - estYaw;

        LogSecs($"[ALARM] Sequence Failed at: {failureStage}", "alarm");
        LogSecs($"[DIAG] EKF:({estX:F3},{estY:F3},{estZ:F3}) | FK_TCP:({fkTcpX:F3},{fkTcpY:F3},{fkTcpZ:F3}) | dXYZ:({deltaX:F3},{deltaY:F3},{deltaZ:F3})", "alarm");
        LogSecs($"[DIAG] Enc_J1:{encJ1:F1} J6:{encJ6:F1} | EKF_Yaw:{estYaw:F1} | Err:{yawError:F1}", "alarm");
        LogSecs($"[DIAG] LaserToF:{tofLaserDist:F3}m | Beam:{(isPhotoelectricBroken ? "BROKEN" : "CLEAR")} | Press:{pressureLeft:F1}/{pressureRight:F1} kPa", "alarm");
        LogSecs($"[DIAG] Overlap:{overlapRatio:P1} | Torque:{tippingTorque:F3}Nm | L_TCP_Est:{adaptiveL_TCP:F4}m", "alarm");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);

            await JSRuntime.InvokeVoidAsync("eval", @"
                window.loadScript = function(src) {
                    return new Promise(function(resolve, reject) {
                        if (window.THREE) { resolve(); return; }
                        var s = document.createElement('script');
                        s.src = src;
                        s.onload = resolve;
                        s.onerror = reject;
                        document.head.appendChild(s);
                    });
                };

                window.ros2SetJointState = function(j1, j2, j3, j4, j5, j6, gripDist) {
                    if (window.ros2RobotSim) window.ros2RobotSim.setJointState(j1, j2, j3, j4, j5, j6, gripDist);
                };
                window.ros2SetRailX = function(xRail) {
                    if (window.ros2RobotSim) window.ros2RobotSim.setRailPositionX(xRail);
                };
                window.ros2ResetBoxPose = function(x, y, z, rx, ry, rz) {
                    if (window.ros2RobotSim) window.ros2RobotSim.resetAndSetRandomBox3DPose(x, y, z, rx, ry, rz);
                };
                window.ros2SetE84IRBeam = function(active) {
                    if (window.ros2RobotSim) window.ros2RobotSim.setE84IRBeamActive(active);
                };
                window.ros2ForceAttachBox = function(attach, isDone) {
                    if (window.ros2RobotSim) window.ros2RobotSim.forceAttachBox(attach, isDone);
                };
                window.ros2SpawnConveyorBox = function() {
                    if (window.ros2RobotSim) window.ros2RobotSim.spawnConveyorBoxFromHost();
                };
                window.ros2SwitchScenario = function(mode) {
                    if (window.ros2RobotSim) window.ros2RobotSim.switchScenarioMode(mode);
                };
                window.ros2Dispose = function() {
                    var sim = window.ros2RobotSim;
                    if (!sim) return;
                    sim._disposed = true;
                    if (sim._raf) cancelAnimationFrame(sim._raf);
                    sim.dotNetRef = null;
                    if (sim.renderer) { sim.renderer.dispose(); }
                    if (sim.rgbdRenderer) { sim.rgbdRenderer.dispose(); }
                    window.ros2RobotSim = null;
                };

                window.initRobotSim = async function(containerId, dotNetRef) {
                    await window.loadScript('https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js');

                    window.ros2RobotSim = {
                        scene: null, camera: null, renderer: null,
                        rgbdCamera: null, rgbdRenderer: null,
                        robotBaseGroup: null,
                        j1Group: null, j2Group: null, j3Group: null, j4Group: null, j5Group: null,
                        leftFinger: null, rightFinger: null,
                        targetBox: null, mainTargetBox: null, eeBase: null,
                        irBeamMesh: null, laserBeamMesh: null, photoelectricMesh: null, entryBeamMesh: null,

                        scenario1Group: null,
                        scenario2Group: null,
                        scenario3Group: null,

                        conveyorItems: [],
                        conveyorBaseSpeed: 0.12,
                        conveyorSpeedA: 0.12,
                        spawnTimer: 0,
                        beltJitterTime: 0,
                        thermalTime: 0,
                        pLeftBias: 0.15,
                        pRightBias: 0.18,
                        lastPublishTime: 0,
                        _lastConvT: 0,
                        _raf: 0,
                        _disposed: false,

                        isAttached: false,
                        boxVelocityY: 0.0,
                        dotNetRef: dotNetRef,
                        attachCooldown: 0,
                        activeScenarioMode: 1,

                        mouseRaycaster: new THREE.Raycaster(),
                        mouseVec: new THREE.Vector2(-999, -999),
                        lastMouseRaycastTime: 0,

                        init: function (cId) {
                            const container = document.getElementById(cId);
                            if (!container) return;

                            const w = container.clientWidth || 500;
                            const h = container.clientHeight || 500;

                            this.scene = new THREE.Scene();
                            this.scene.background = new THREE.Color(0x1e1e24);

                            this.camera = new THREE.PerspectiveCamera(45, w / h, 0.1, 1000);
                            this.camera.position.set(2.8, 2.2, 3.2);
                            this.camera.lookAt(0, 0.5, 0.6);

                            this.renderer = new THREE.WebGLRenderer({ antialias: true });
                            this.renderer.setSize(w, h);
                            this.renderer.shadowMap.enabled = true;
                            container.innerHTML = '';
                            container.appendChild(this.renderer.domElement);

                            const rgbdContainer = document.getElementById('rgbd-canvas');
                            if (rgbdContainer) {
                                const renderSize = 512;
                                this.rgbdRenderer = new THREE.WebGLRenderer({ antialias: true, preserveDrawingBuffer: true });
                                this.rgbdRenderer.setSize(renderSize, renderSize);
                                rgbdContainer.innerHTML = '';
                                rgbdContainer.appendChild(this.rgbdRenderer.domElement);
                                this.rgbdRenderer.domElement.style.width = '100%';
                                this.rgbdRenderer.domElement.style.height = '100%';
                            }

                            const ambientLight = new THREE.AmbientLight(0xffffff, 0.8);
                            this.scene.add(ambientLight);

                            const dirLight = new THREE.DirectionalLight(0xffffff, 1.0);
                            dirLight.position.set(5, 10, 5);
                            dirLight.castShadow = true;
                            this.scene.add(dirLight);

                            const grid = new THREE.GridHelper(10, 10, 0x00d2ff, 0x333344);
                            this.scene.add(grid);

                            const floor = new THREE.Mesh(
                                new THREE.PlaneGeometry(10, 10),
                                new THREE.MeshStandardMaterial({ color: 0x151518, roughness: 0.8 })
                            );
                            floor.rotation.x = -Math.PI / 2;
                            floor.receiveShadow = true;
                            this.scene.add(floor);

                            this.robotBaseGroup = new THREE.Group();
                            this.scene.add(this.robotBaseGroup);

                            this.buildRealisticRobot();
                            this.createTargetObject();
                            this.createWorldVerticalE84IRBeam();
                            this.createLaserAndPhotoelectricSensors();

                            this.buildScenario2Rail();
                            this.buildScenario3Conveyors();

                            this.switchScenarioMode(1);

                            container.addEventListener('mousemove', (evt) => {
                                const rect = container.getBoundingClientRect();
                                this.mouseVec.x = ((evt.clientX - rect.left) / container.clientWidth) * 2 - 1;
                                this.mouseVec.y = -((evt.clientY - rect.top) / container.clientHeight) * 2 + 1;
                            });

                            const animate = () => {
                                if (this._disposed) return;
                                this._raf = requestAnimationFrame(animate);
                                try {
                                    this.updateConveyorPhysics();
                                    this.updateWorldE84IRBeam();
                                    this.updateLaserAndPhotoelectricSensors();
                                    this.updateBoxRigidBodyPhysics();
                                    this.enforceAbsoluteWorldFloorClamp();
                                    this.checkGraspPhysics();
                                    this.publishSensorStreamPacket();
                                    this.updateMouseWorldCoords();
                                } catch(e) {}
                                this.renderer.render(this.scene, this.camera);

                                if (this.rgbdRenderer && this.rgbdCamera) {
                                    this.rgbdRenderer.render(this.scene, this.rgbdCamera);
                                }
                            };
                            animate();
                        },

                        updateMouseWorldCoords: function() {
                            const now = performance.now();
                            if (now - this.lastMouseRaycastTime < 33) return;
                            this.lastMouseRaycastTime = now;

                            if (!this.camera || !this.mouseRaycaster) return;

                            this.mouseRaycaster.setFromCamera(this.mouseVec, this.camera);

                            const intersects = this.mouseRaycaster.intersectObjects(this.scene.children, true);

                            const hit = intersects.find(i =>
                                i.object.visible &&
                                i.object.type === 'Mesh' &&
                                i.object !== this.laserBeamMesh &&
                                i.object !== this.irBeamMesh &&
                                i.object !== this.photoelectricMesh &&
                                i.object !== this.entryBeamMesh
                            );

                            const elem = document.getElementById('mouse-coords');
                            if (!elem) return;

                            if (hit) {
                                elem.innerText = `World Coordinates (Z-Up): (X: ${hit.point.x.toFixed(3)}, Y: ${hit.point.z.toFixed(3)}, Z: ${hit.point.y.toFixed(3)})m`;
                                elem.style.color = '#00ffcc';
                            } else {
                                const groundPlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0);
                                const intersectPoint = new THREE.Vector3();
                                if (this.mouseRaycaster.ray.intersectPlane(groundPlane, intersectPoint)) {
                                    elem.innerText = `World Coordinates (Z-Up): (X: ${intersectPoint.x.toFixed(3)}, Y: ${intersectPoint.z.toFixed(3)}, Z: ${intersectPoint.y.toFixed(3)})m`;
                                    elem.style.color = '#888888';
                                }
                            }
                        },

                        switchScenarioMode: function(mode) {
                            this.activeScenarioMode = mode;

                            if (this.isAttached && this.targetBox) {
                                this.scene.attach(this.targetBox);
                                this.isAttached = false;
                            }
                            this.attachCooldown = 0;
                            this.boxVelocityY = 0.0;

                            this.clearConveyorItems();

                            if (this.mainTargetBox) {
                                if (this.mainTargetBox.parent !== this.scene) {
                                    this.scene.attach(this.mainTargetBox);
                                }
                                this.mainTargetBox.material.color.setHex(0xef233c);
                                this.mainTargetBox.visible = (mode !== 3);
                                if (mode !== 3) {
                                    this.targetBox = this.mainTargetBox;
                                }
                            }

                            if (mode !== 2 && this.robotBaseGroup) {
                                this.robotBaseGroup.position.x = 0;
                            }

                            if (this.scenario1Group) this.scenario1Group.visible = (mode === 1);
                            if (this.scenario2Group) this.scenario2Group.visible = (mode === 2);
                            if (this.scenario3Group) this.scenario3Group.visible = (mode === 3);

                            this.scene.updateMatrixWorld(true);
                        },

                        clearConveyorItems: function() {
                            for (let item of this.conveyorItems) {
                                if (this.isAttached && this.targetBox === item) {
                                    this.scene.attach(item);
                                    this.isAttached = false;
                                }
                                this.scene.remove(item);
                                if (item.geometry) item.geometry.dispose();
                                if (item.material) item.material.dispose();
                            }
                            this.conveyorItems = [];
                        },

                        spawnConveyorItem: function(startZ = -0.50) {
                            const sizeJitter = 0.12 + (Math.random() - 0.5) * 0.003;
                            const boxGeo = new THREE.BoxGeometry(sizeJitter, sizeJitter, sizeJitter);
                            const boxMat = new THREE.MeshStandardMaterial({ color: 0xef233c, roughness: 0.3 });
                            const item = new THREE.Mesh(boxGeo, boxMat);

                            const landingTilt = (Math.random() - 0.5) * (1.8 * Math.PI / 180.0);
                            item.position.set(-0.75, 0.14, startZ);
                            item.rotation.set(0, landingTilt, 0);
                            item.beltState = 'A';
                            item.castShadow = true;

                            this.scene.add(item);
                            this.conveyorItems.push(item);
                            if (!this.isAttached && !this.targetBox) {
                                this.targetBox = item;
                            }
                        },

                        spawnConveyorBoxFromHost: function() {
                            this.spawnConveyorItem(-0.50);
                        },

                        buildScenario2Rail: function() {
                            this.scenario2Group = new THREE.Group();
                            const railMat = new THREE.MeshStandardMaterial({ color: 0x444450, metalness: 0.8, roughness: 0.2 });
                            const trackGeo = new THREE.BoxGeometry(2.6, 0.08, 0.4);
                            const trackMesh = new THREE.Mesh(trackGeo, railMat);
                            trackMesh.position.set(0, 0.04, 0);
                            this.scenario2Group.add(trackMesh);

                            const guideLineGeo = new THREE.BoxGeometry(2.6, 0.02, 0.04);
                            const guideLineMat = new THREE.MeshStandardMaterial({ color: 0x00d2ff, metalness: 0.9 });
                            const g1 = new THREE.Mesh(guideLineGeo, guideLineMat); g1.position.set(0, 0.09, -0.1);
                            const g2 = new THREE.Mesh(guideLineGeo, guideLineMat); g2.position.set(0, 0.09, 0.1);
                            this.scenario2Group.add(g1); this.scenario2Group.add(g2);

                            this.scene.add(this.scenario2Group);
                        },

                        buildScenario3Conveyors: function() {
                            this.scenario3Group = new THREE.Group();
                            const beltMat = new THREE.MeshStandardMaterial({ color: 0x111115, roughness: 0.9 });
                            const postMat = new THREE.MeshStandardMaterial({ color: 0xffffff, metalness: 0.5, roughness: 0.2 });
                            const camMat = new THREE.MeshStandardMaterial({ color: 0x00d2ff, metalness: 0.9 });

                            const beltAGeo = new THREE.BoxGeometry(0.35, 0.08, 2.5);
                            const beltA = new THREE.Mesh(beltAGeo, beltMat);
                            beltA.position.set(-0.75, 0.04, 0.70);
                            this.scenario3Group.add(beltA);

                            const beltBGeo = new THREE.BoxGeometry(2.5, 0.08, 0.35);
                            const beltB = new THREE.Mesh(beltBGeo, beltMat);
                            beltB.position.set(0.70, 0.04, 0.75);
                            this.scenario3Group.add(beltB);

                            const gateLeft = new THREE.Mesh(new THREE.CylinderGeometry(0.015, 0.015, 0.35, 16), postMat);
                            gateLeft.position.set(-0.95, 0.20, -0.60);
                            this.scenario3Group.add(gateLeft);

                            const gateRight = new THREE.Mesh(new THREE.CylinderGeometry(0.015, 0.015, 0.35, 16), postMat);
                            gateRight.position.set(-0.55, 0.20, -0.60);
                            this.scenario3Group.add(gateRight);

                            const gateTop = new THREE.Mesh(new THREE.BoxGeometry(0.44, 0.03, 0.03), postMat);
                            gateTop.position.set(-0.75, 0.36, -0.60);
                            this.scenario3Group.add(gateTop);

                            const topCamera = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.04, 0.06), camMat);
                            topCamera.position.set(-0.75, 0.34, -0.60);
                            this.scenario3Group.add(topCamera);

                            const beamGeo = new THREE.CylinderGeometry(0.003, 0.003, 0.40, 16);
                            const beamMat = new THREE.MeshBasicMaterial({ color: 0x00ffcc, transparent: true, opacity: 0.85 });
                            this.entryBeamMesh = new THREE.Mesh(beamGeo, beamMat);
                            this.entryBeamMesh.rotation.z = Math.PI / 2;
                            this.entryBeamMesh.position.set(-0.75, 0.20, -0.60);
                            this.scenario3Group.add(this.entryBeamMesh);

                            this.scene.add(this.scenario3Group);
                        },

                        updateConveyorPhysics: function() {
                            const nowT = performance.now();
                            const dt = Math.min(0.05, (nowT - (this._lastConvT || nowT)) / 1000.0);
                            this._lastConvT = nowT;

                            if (this.activeScenarioMode !== 3) return;

                            this.spawnTimer += dt;
                            this.beltJitterTime += dt;

                            const speedJitter = 1.0 + 0.04 * Math.sin(2.0 * Math.PI * 1.5 * this.beltJitterTime) + (Math.random() - 0.5) * 0.01;
                            this.conveyorSpeedA = this.conveyorBaseSpeed * speedJitter;

                            let lastItem = this.conveyorItems[this.conveyorItems.length - 1];
                            let minPitchMet = !lastItem || (lastItem.position.z > 0.40);
                            let targetSpawnInterval = 6.8 + (Math.random() - 0.5) * 0.4;

                            if (this.spawnTimer >= targetSpawnInterval && minPitchMet && this.conveyorItems.length < 5) {
                                this.spawnTimer = 0;
                                this.spawnConveyorItem(-0.50);
                            }

                            let isEntryGateTriggered = false;

                            for (let i = this.conveyorItems.length - 1; i >= 0; i--) {
                                let item = this.conveyorItems[i];

                                if (item.beltState === 'A' && Math.abs(item.position.z - (-0.60)) < 0.08) {
                                    isEntryGateTriggered = true;
                                }

                                if (item === this.targetBox && this.isAttached) continue;

                                if (item.beltState === 'A') {
                                    item.position.z += this.conveyorSpeedA * dt;
                                    if (item.position.z > 1.8) {
                                        this.scene.remove(item);
                                        if (item.geometry) item.geometry.dispose();
                                        if (item.material) item.material.dispose();
                                        this.conveyorItems.splice(i, 1);
                                        if (this.targetBox === item) this.targetBox = null;
                                    }
                                } else if (item.beltState === 'B') {
                                    item.position.x += this.conveyorSpeedA * dt;
                                    if (item.position.x > 1.8) {
                                        this.scene.remove(item);
                                        if (item.geometry) item.geometry.dispose();
                                        if (item.material) item.material.dispose();
                                        this.conveyorItems.splice(i, 1);
                                    }
                                }
                            }

                            if (this.entryBeamMesh) {
                                this.entryBeamMesh.material.color.setHex(isEntryGateTriggered ? 0xff0055 : 0x00ffcc);
                            }

                            if (!this.isAttached) {
                                let isTargetValid = this.targetBox &&
                                                    this.targetBox.parent === this.scene &&
                                                    this.targetBox.beltState === 'A' &&
                                                    this.targetBox.position.z >= -0.65 &&
                                                    this.targetBox.position.z <= 1.20;
                                if (!isTargetValid) {
                                    let closest = null;
                                    let minZ = 999;
                                    for (let item of this.conveyorItems) {
                                        if (item.beltState === 'A' && item.position.z >= -0.60 && item.position.z <= 0.80) {
                                            if (item.position.z < minZ) {
                                                minZ = item.position.z;
                                                closest = item;
                                            }
                                        }
                                    }
                                    this.targetBox = closest;
                                }
                            }
                        },

                        setRailPositionX: function(xRail) {
                            if (this.robotBaseGroup) {
                                this.robotBaseGroup.position.x = xRail;
                            }
                        },

                        buildRealisticRobot: function () {
                            const baseMat = new THREE.MeshStandardMaterial({ color: 0x22252a, metalness: 0.8, roughness: 0.3 });
                            const armMat = new THREE.MeshStandardMaterial({ color: 0xdae2e8, metalness: 0.5, roughness: 0.4 });
                            const jointMat = new THREE.MeshStandardMaterial({ color: 0x007acc, metalness: 0.7, roughness: 0.2 });
                            const accentMat = new THREE.MeshStandardMaterial({ color: 0xffb703, metalness: 0.6, roughness: 0.3 });
                            const cameraMat = new THREE.MeshStandardMaterial({ color: 0xff0055, metalness: 0.9 });
                            const sensorMat = new THREE.MeshStandardMaterial({ color: 0x00ffcc, metalness: 0.8 });
                            const ringMat = new THREE.MeshStandardMaterial({ color: 0xffd166, metalness: 0.9, roughness: 0.1 });

                            const basePlate = new THREE.Mesh(new THREE.CylinderGeometry(0.5, 0.6, 0.2, 32), baseMat);
                            basePlate.position.y = 0.1;
                            this.robotBaseGroup.add(basePlate);

                            this.j1Group = new THREE.Group();
                            this.j1Group.position.y = 0.2;
                            this.robotBaseGroup.add(this.j1Group);

                            const j1Mesh = new THREE.Mesh(new THREE.CylinderGeometry(0.35, 0.35, 0.25, 32), jointMat);
                            j1Mesh.position.y = 0.125;
                            this.j1Group.add(j1Mesh);

                            const j1Ring = new THREE.Mesh(new THREE.TorusGeometry(0.36, 0.02, 16, 32), ringMat);
                            j1Ring.rotation.x = Math.PI / 2;
                            j1Ring.position.y = 0.25;
                            this.j1Group.add(j1Ring);

                            const link1 = new THREE.Mesh(new THREE.CylinderGeometry(0.18, 0.18, 0.675, 32), armMat);
                            link1.position.y = 0.4625;
                            this.j1Group.add(link1);

                            this.j2Group = new THREE.Group();
                            this.j2Group.position.y = 0.8;
                            this.j1Group.add(this.j2Group);

                            const j2Mesh = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.2, 0.4, 32), jointMat);
                            j2Mesh.rotation.z = Math.PI / 2;
                            this.j2Group.add(j2Mesh);

                            const link2 = new THREE.Mesh(new THREE.CylinderGeometry(0.14, 0.16, 0.8, 32), armMat);
                            link2.position.z = 0.4;
                            link2.rotation.x = Math.PI / 2;
