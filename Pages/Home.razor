                j6Angle = FAB_HOME_J6;
            }
            gripperDist = FAB_HOME_GRIP;

            diagnosticMessage = activeScenario == 2 
                ? $"🎲 情境 2 重置：導軌 X={xRailPos:F2}m，物體估算 X={spawnX:F2}m，全軸隨機化！"
                : $"🎲 深層重置，情境 {activeScenario} 隨機化完成！";

            LogSecs($"S6F11: CEID 1000 (Scene_Randomized_Scenario_{activeScenario}_RailX_{xRailPos:F2})", "eq");

            ComputeForwardKinematics();
            await SyncToSim();
        }
        catch (Exception ex)
        {
            LogSecs($"⚠️ 重置場景異常捕捉: {ex.Message}", "alarm");
        }
        finally
        {
            isResetting = false; 
            await InvokeAsync(StateHasChanged);
        }
    }

