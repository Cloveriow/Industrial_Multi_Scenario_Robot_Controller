    // 🌟 全自動雙輸送帶連鎖追蹤 (CEID 1009 動態可達性修剪 Interlock + 邊緣觸發洗版抑制 + 異常復原重啟)
    private async Task RunScenario3AutoLoop(CancellationToken ct)
    {
        try
        {
            LogSecs("🤖 [情境 3] 全自動動態流水線循環啟動 (Endless Auto-Loop Active)...", "host");

            // 預先飛往 Belt A 入口預備佇列 (J1 ≈ -105°)
            double initStagingX = -0.75;
            double initStagingY = -0.20 + (0.12 * 0.65);
            if (SolveIK(initStagingX, initStagingY, 0.28, 0.0, out double initJ1, out double initJ2, out double initJ3, out double initJ4, out double initJ5, out double initJ6))
            {
                var initWaypoints = new List<JointState>
                {
                    new JointState { J1 = j1Angle, J2 = j2Angle, J3 = j3Angle, J4 = j4Angle, J5 = j5Angle, J6 = j6Angle, Grip = FAB_HOME_GRIP },
                    new JointState { J1 = initJ1, J2 = initJ2, J3 = initJ3, J4 = initJ4, J5 = initJ5, J6 = initJ6, Grip = FAB_HOME_GRIP }
                };
                LogSecs($"[Command] Multi-Axis CP Arc to Initial Staging | Tgt Y:{initStagingY:F3}m", "host");
                await MoveAlongSCurvePathWithDynamics(initWaypoints, isPrecision: false, isLifting: false, ct: ct);
            }

            await SpawnConveyorBox();

            double lastPrunedY = -999.0; 

            while (!ct.IsCancellationRequested && activeScenario == 3)
            {
                // 🌟 動態預備點復原保護：如果剛逃逸退回 HOME，主動飛回迎擊點，消滅無限 Prune 循環
                if (isWaitingForStagingRecovery && !isExecutingTask)
                {
                    LogSecs("🚀 [Recovery] 從安全位置主動飛回 Belt A 迎擊準備點...", "host");
                    if (SolveIK(initStagingX, initStagingY, 0.28, 0.0, out double rJ1, out double rJ2, out double rJ3, out double rJ4, out double rJ5, out double rJ6))
                    {
                        var recoveryWaypoints = new List<JointState>
                        {
                            new JointState { J1 = j1Angle, J2 = j2Angle, J3 = j3Angle, J4 = j4Angle, J5 = j5Angle, J6 = j6Angle, Grip = FAB_HOME_GRIP },
                            new JointState { J1 = j1Angle, J2 = -25.0, J3 = 45.0, J4 = 70.0, J5 = 0, J6 = rJ6, Grip = FAB_HOME_GRIP },
                            new JointState { J1 = rJ1, J2 = rJ2, J3 = rJ3, J4 = rJ4, J5 = rJ5, J6 = rJ6, Grip = FAB_HOME_GRIP }
                        };
                        await MoveAlongSCurvePathWithDynamics(recoveryWaypoints, isPrecision: false, isLifting: false, ct: ct);
                    }
                    isWaitingForStagingRecovery = false;
                    lastPrunedY = -999.0;
                }

                if (!isGrasped && !isExecutingTask)
                {
                    double estFlyTime = 0.8; 
                    double predictedReachY = estY + (0.12 * estFlyTime);
                    double maxPickWorkspaceY = 0.350; 

                    if (predictedReachY > maxPickWorkspaceY)
                    {
                        if (Math.Abs(estY - lastPrunedY) > 0.25)
                        {
                            lastPrunedY = estY;
                            LogSecs($"S6F11: CEID 1008 (Target_Pruned_Unreachable_Time_Deficit) | EstY:{estY:F3}m -> PredictedReachY:{predictedReachY:F3}m > WorkspaceMax:{maxPickWorkspaceY:F3}m", "alarm");
                        }
                        await Task.Delay(250, ct); 
                    }
                    else if (estY >= -0.60 && estY <= 0.35 && Math.Abs(estX - (-0.75)) < 0.35)
                    {
                        try
                        {
                            isExecutingTask = true;
                            isTransferDone = false;
                            lastPrunedY = -999.0;
                            LogSecs($"🎯 [CEID 1007: Upstream Intercept] 門相機 EKF 鎖定上游物料 (GT_Y={gtY:F3}m) | 啟動 3D 斜向預測迎擊", "host");
                            
                            bool graspOk = await ExecuteGraspSequence(compX: 0, compY: 0, ct: ct);

                            if (graspOk)
                            {
                                double dropX = 0.75; 
                                double dropY = 0.75;
                                double dropZ = 0.14; 

                                LogSecs($"🏭 [Step 4] 轉向 CP 軌跡移載至 Belt B (高空姿態擺正至 Yaw=0.0° -> X:{dropX:F2}, Y:{dropY:F2})...", "host");
                                
                                SolveIK(dropX, dropY, dropZ + 0.15, 0.0, out double ikJ1, out double ikJ2, out double ikJ3, out double ikJ4, out double ikJ5, out double ikJ6);
                                LogSecs($"[Kinematics] Belt B Place IK Solved | Tgt J1~J6: ({ikJ1:F1}°,{ikJ2:F1}°,{ikJ3:F1}°,{ikJ4:F1}°,{ikJ5:F1}°,{ikJ6:F1}°)", "host");
                                
                                double midJ1 = j1Angle + (ikJ1 - j1Angle) * 0.5;
                                double arcJ2 = -25.0; 
                                double arcJ3 = 45.0;  
                                double arcJ4 = 90.0 - (arcJ2 + arcJ3);

                                var transferWaypoints = new List<JointState>
                                {
                                    new JointState { J1 = j1Angle, J2 = j2Angle, J3 = j3Angle, J4 = j4Angle, J5 = j5Angle, J6 = j6Angle, Grip = gripperDist },
                                    new JointState { J1 = j1Angle + (ikJ1 - j1Angle)*0.25, J2 = arcJ2, J3 = arcJ3, J4 = arcJ4, J5 = 0, J6 = j6Angle + (ikJ6 - j6Angle)*0.25, Grip = SOLID_GRIP_LIMIT },
                                    new JointState { J1 = midJ1, J2 = arcJ2, J3 = arcJ3, J4 = arcJ4, J5 = 0, J6 = j6Angle + (ikJ6 - j6Angle)*0.50, Grip = SOLID_GRIP_LIMIT },
                                    new JointState { J1 = ikJ1, J2 = ikJ2 * 0.8, J3 = ikJ3 * 0.8, J4 = 90.0 - (ikJ2*0.8 + ikJ3*0.8), J5 = 0, J6 = j6Angle + (ikJ6 - ikJ6)*0.85, Grip = SOLID_GRIP_LIMIT },
                                    new JointState { J1 = ikJ1, J2 = ikJ2, J3 = ikJ3, J4 = ikJ4, J5 = ikJ5, J6 = ikJ6, Grip = SOLID_GRIP_LIMIT }
                                };

                                await MoveAlongSCurvePathWithDynamics(transferWaypoints, isPrecision: true, isLifting: true, ct: ct);

                                LogSecs("⏳ [INP Wait] 等待高空姿態擺正與馬達動態誤差收斂 (In-Position)...", "host");
                                for (int k = 0; k < 30; k++)
                                {
                                    if (ct.IsCancellationRequested) return;
                                    StepFullMultibodyDynamics(ikJ1, ikJ2, ikJ3, ikJ4, ikJ5, ikJ6, isPrecisionZone: true, dt: 0.015);
                                    await SyncToSim();
                                    await Task.Delay(10, ct);
                                }

                                LogSecs("📐 [Place Step 2] 純笛卡兒垂直向下放座 (姿態早已擺正，零轉速直下)...", "host");
                                await MoveLinearTaskSpace(fkTcpX, fkTcpY, fkTcpZ, fkTcpX, fkTcpY, dropZ, 0.0, steps: 0, ct: ct);

                                await JSRuntime.InvokeVoidAsync("ros2ForceAttachBox", false, true);
                                isGrasped = false;

                                await SmoothOpenGripperToHomeLimit(ct: ct);

                                LogSecs("🚀 [SEMI 退刀] 放座完成，發動 J1/J2/J3 順滑同動退刀並直飛動態預備位...", "host");
                                await ExecuteScenario3FabUnloadToStagingSequence(dropX, dropY, ct: ct);

                                isTransferDone = true;
                                LogSecs("🎉 [全自動] 情境 3 完成一次標準擺正夾放，手臂已於預備位佇列就緒！", "host");
                            }
                            else
                            {
                                isGrasped = false;
                                isWaitingForStagingRecovery = true; // 抓取失敗退回HOME，標記需主動復原
                            }
                        }
                        catch (OperationCanceledException) { break; }
                        catch (Exception ex)
                        {
                            LogSecs($"⚠️ 情境 3 自動試夾單次例外: {ex.Message}", "alarm");
                            isWaitingForStagingRecovery = true;
                        }
                        finally
                        {
                            isExecutingTask = false;
                        }
                    }
                }

                await Task.Delay(100, ct); 
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            LogSecs($"🚨 情境 3 背景連鎖例外捕捉: {ex.Message}", "alarm");
        }
    }

    // 🌟 情境 3 專用退刀規程：放座後抬升同動旋轉 J1/J2/J3 直飛預測迎擊點
    private async Task ExecuteScenario3FabUnloadToStagingSequence(double placeX, double placeY, CancellationToken ct = default)
    {
        admittanceOffsetZ = 0.0;
        admittanceVelZ = 0.0;

        double flyTimeSecs = 1.2; 
        double nextStagingX = -0.75;
        double nextStagingY = -0.30; 
        
        if (estY > -0.60 && estY < 0.10) {
            nextStagingY = estY + (0.12 * flyTimeSecs);
        }

        SolveIK(nextStagingX, nextStagingY, 0.28, 0.0, out double nStgJ1, out double pStgJ2, out double pStgJ3, out double pStgJ4, out double pStgJ5, out double pStgJ6);

        // 🌟 J1, J2, J3 多軸同時連貫滑動 (Simultaneous Retract Motion)
        var smoothArcUnloadWaypoints = new List<JointState>
        {
            new JointState { J1 = j1Angle, J2 = j2Angle, J3 = j3Angle, J4 = j4Angle, J5 = j5Angle, J6 = j6Angle, Grip = FAB_HOME_GRIP },
            new JointState { J1 = j1Angle + (nStgJ1 - j1Angle)*0.4, J2 = -25.0, J3 = 50.0, J4 = 65.0, J5 = 0, J6 = pStgJ6, Grip = FAB_HOME_GRIP },
            new JointState { J1 = nStgJ1, J2 = pStgJ2, J3 = pStgJ3, J4 = pStgJ4, J5 = pStgJ5, J6 = pStgJ6, Grip = FAB_HOME_GRIP }
        };

        LogSecs($"[Algorithm] Predict Next Staging | FlyTime: {flyTimeSecs:F1}s | TgtY: {nextStagingY:F3}m", "host");
        LogSecs($"🚀 [CP Retract Arc] J1/J2/J3 關節同時圓弧動態退刀 | Tgt J1~J6: ({nStgJ1:F1}°,{pStgJ2:F1}°,{pStgJ3:F1}°,{pStgJ4:F1}°,{pStgJ5:F1}°,{pStgJ6:F1}°)", "host");
        await MoveAlongSCurvePathWithDynamics(smoothArcUnloadWaypoints, isPrecision: false, isLifting: false, ct: ct);
    }

    // 🌟 情境 1 & 2 標準退刀規程
    private async Task ExecuteFabStandardUnloadSequence(double placeX, double placeY, double currentJ1, double currentJ2, double currentJ3, double currentJ4, double currentJ5, double currentJ6, CancellationToken ct = default)
    {
        admittanceOffsetZ = 0.0;
        admittanceVelZ = 0.0;

        double startX = fkTcpX;
        double startY = fkTcpY;
        double startZ = fkTcpZ;

        double liftZ = startZ + 0.18;
        LogSecs($"[Command] Fab Unload Phase 0: Z-Lift | Start Z:{startZ:F3}m -> End Z:{liftZ:F3}m", "host");
        await MoveLinearTaskSpace(startX, startY, startZ, startX, startY, liftZ, estYaw, steps: 45, ct: ct);

        double radJ1 = currentJ1 * (Math.PI / 180.0);
        double exitX = startX - 0.28 * Math.Sin(radJ1);
        double exitY = startY - 0.28 * Math.Cos(radJ1);

        LogSecs($"[Command] Fab Unload Phase 1: Drawback | Tgt XY:({exitX:F3}, {exitY:F3})", "host");
        await MoveLinearTaskSpace(startX, startY, liftZ, exitX, exitY, liftZ, estYaw, steps: 40, ct: ct);

        LogSecs("📐 [Fab 退刀 Phase 2] 安全離腔，手臂平滑縮臂歸位 HOME...", "host");
        await ExecuteUprisingArchHomeSequence(ct: ct);
    }

