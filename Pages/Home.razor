                        createWorldVerticalE84IRBeam: function () {
                            const beamGeo = new THREE.CylinderGeometry(0.006, 0.006, 1.0, 16);
                            const beamMat = new THREE.MeshBasicMaterial({ color: 0xff0055, transparent: true, opacity: 0.85 });
                            this.irBeamMesh = new THREE.Mesh(beamGeo, beamMat);
                            this.irBeamMesh.visible = false;
                            this.scene.add(this.irBeamMesh);
                        },

                        updateWorldE84IRBeam: function () {
                            if (!this.irBeamMesh || !this.irBeamMesh.visible || !this.eeBase) return;

                            this.scene.updateMatrixWorld(true);
                            const tcpWorldPos = new THREE.Vector3();
                            this.eeBase.getWorldPosition(tcpWorldPos);

                            const groundY = 0.06;
                            const height = Math.max(0.05, tcpWorldPos.y - groundY);

                            this.irBeamMesh.scale.set(1, height, 1);
                            this.irBeamMesh.position.set(tcpWorldPos.x, tcpWorldPos.y - (height / 2.0), tcpWorldPos.z);
