                        publishSensorStreamPacket: function () {
                            const now = performance.now();
                            if (!this.lastPublishTime) this.lastPublishTime = now;
                            if (now - this.lastPublishTime < 33.0) return; 
                            this.lastPublishTime = now;

                            if (!this.dotNetRef) return;
                            if (!this.leftFinger || !this.rightFinger || !this.targetBox || !this.targetBox.parent || !this.eeBase) return;

                            this.scene.updateMatrixWorld(true);

                            const leftPos = new THREE.Vector3();
                            const rightPos = new THREE.Vector3();
                            const boxPos = new THREE.Vector3();

                            this.leftFinger.getWorldPosition(leftPos);
                            this.rightFinger.getWorldPosition(rightPos);
                            this.targetBox.getWorldPosition(boxPos);

                            if (isNaN(boxPos.x) || isNaN(boxPos.y) || isNaN(boxPos.z)) return;

                            const tcpCenter = new THREE.Vector3().addVectors(leftPos, rightPos).multiplyScalar(0.5);
                            const dx = tcpCenter.x - boxPos.x;
                            const dz = tcpCenter.z - boxPos.z;
                            const horizontalDist = Math.sqrt(dx * dx + dz * dz);

                            const fingerWorldDir = new THREE.Vector3(1, 0, 0).applyQuaternion(this.eeBase.getWorldQuaternion(new THREE.Quaternion()));
                            const eeWorldYaw = Math.atan2(fingerWorldDir.z, fingerWorldDir.x);

                            const boxWorldQuat = new THREE.Quaternion();
                            this.targetBox.getWorldQuaternion(boxWorldQuat);
                            const boxWorldEuler = new THREE.Euler().setFromQuaternion(boxWorldQuat, 'YXZ');
                            const boxYaw = boxWorldEuler.y;

                            let angleDiff = Math.abs(boxYaw - eeWorldYaw) % (Math.PI / 2);
                            if (angleDiff > Math.PI / 4) angleDiff = Math.PI / 2 - angleDiff;

                            const alignFactor = Math.cos(angleDiff);
                            const overlapPercent = Math.max(0.0, Math.min(1.0, (1.0 - (horizontalDist / 0.12)) * alignFactor));

                            const isBeamBroken = (horizontalDist < 0.08 && Math.abs(tcpCenter.y - boxPos.y) < 0.06);
                            if (this.photoelectricMesh) {
                                this.photoelectricMesh.material.color.setHex(isBeamBroken ? 0x00ffcc : 0xff0055);
                            }

                            const pixelGridSize = 512.0;
                            const subPixelJitter = (Math.random() - 0.5) * (1.0 / pixelGridSize) * 0.15;

                            const depthDist = Math.sqrt(boxPos.x * boxPos.x + boxPos.y * boxPos.y + boxPos.z * boxPos.z);
                            const depthNoiseCoeff = 0.0018 * (1.0 + depthDist * depthDist * 0.7);
                            let noiseX = ((Math.random() - 0.5) * depthNoiseCoeff) + subPixelJitter;
                            let noiseY = ((Math.random() - 0.5) * depthNoiseCoeff) + subPixelJitter;
                            let noiseZ = ((Math.random() - 0.5) * depthNoiseCoeff) + subPixelJitter;

                            if (Math.random() < 0.015) {
                                noiseZ += (Math.random() - 0.5) * 0.07;
                            }

                            const noiseYaw = (Math.random() - 0.5) * 0.8;

                            this.thermalTime = (this.thermalTime || 0) + 0.016;
                            const thermalDrift = 0.0012 * Math.sin(this.thermalTime * 0.05);
                            const laserNoise = (Math.random() - 0.5) * (0.001 + tcpCenter.y * 0.003) + thermalDrift;
                            const laserDist = Math.max(0.0, tcpCenter.y + laserNoise);

                            this.pLeftBias = (this.pLeftBias || 0.15) + (Math.random() - 0.5) * 0.0005;
                            this.pRightBias = (this.pRightBias || 0.18) + (Math.random() - 0.5) * 0.0005;

                            let pL = this.pLeftBias, pR = this.pRightBias;
                            let pressureThreshY = this.targetBox ? (this.targetBox.position.y + 0.002) : 0.062;

                            if (this.isAttached) {
                                pL = 12.4 + (Math.random() - 0.5) * 0.25;
                                pR = 12.6 + (Math.random() - 0.5) * 0.25;
                            } else if (tcpCenter.y <= pressureThreshY && horizontalDist < 0.06) {
                                const penetDepth = Math.max(0, pressureThreshY - tcpCenter.y);
                                pL = 12.0 + (penetDepth * 800.0) + pL;
                                pR = 12.0 + (penetDepth * 800.0) + pR;
                            }

                            const coggingJ1 = 0.03 * Math.sin((this.j1Group ? this.j1Group.rotation.y : 0) * 12.0);
                            const coggingJ2 = 0.03 * Math.sin((this.j2Group ? this.j2Group.rotation.x : 0) * 12.0);
                            const coggingJ3 = 0.03 * Math.sin((this.j3Group ? this.j3Group.rotation.x : 0) * 12.0);

                            const packet = {
                                RgbdX: boxPos.x + noiseX,
                                RgbdY: boxPos.z + noiseZ,
                                RgbdZ: boxPos.y + noiseY,
                                RgbdYaw: (boxYaw * (180.0 / Math.PI)) + noiseYaw,
                                LaserDist: laserDist,
                                IsBeamBroken: isBeamBroken,
                                PressureL: pL,
                                PressureR: pR,
                                Enc1: (this.j1Group ? this.j1Group.rotation.y * (180 / Math.PI) : 0) + coggingJ1,
                                Enc2: (this.j2Group ? this.j2Group.rotation.x * (180 / Math.PI) : 0) + coggingJ2,
                                Enc3: (this.j3Group ? this.j3Group.rotation.x * (180 / Math.PI) : 0) + coggingJ3,
                                Enc4: this.j4Group ? this.j4Group.rotation.x * (180 / Math.PI) : 0,
                                Enc5: this.j5Group ? this.j5Group.rotation.x * (180 / Math.PI) : 0,
                                Enc6: this.eeBase ? this.eeBase.rotation.z * (180 / Math.PI) : 0,
                                OverlapRatio: overlapPercent,
                                BeltSpeed: this.activeScenarioMode === 3 ? this.conveyorSpeedA : 0.0
                            };

                            this.dotNetRef.invokeMethodAsync('OnSensorStreamUpdate', packet);
                        },

                        setJointState: function (j1, j2, j3, j4, j5, j6, gripDist) {
                            if (isNaN(j1) || isNaN(j2) || isNaN(j3) || isNaN(j4) || isNaN(j5) || isNaN(j6) || isNaN(gripDist)) return;

                            if (this.j1Group) this.j1Group.rotation.y = j1 * (Math.PI / 180);
                            if (this.j2Group) this.j2Group.rotation.x = j2 * (Math.PI / 180);
                            if (this.j3Group) this.j3Group.rotation.x = j3 * (Math.PI / 180);
                            if (this.j4Group) this.j4Group.rotation.x = j4 * (Math.PI / 180);
                            if (this.j5Group) this.j5Group.rotation.x = j5 * (Math.PI / 180);

                            if (this.eeBase) {
                                this.eeBase.position.set(0, 0, 0.03);
                                this.eeBase.rotation.z = j6 * (Math.PI / 180);
                            }

                            if (this.leftFinger && this.rightFinger) {
                                const half = gripDist / 2.0;
                                this.leftFinger.position.x = -half;
                                this.rightFinger.position.x = half;
                            }

                            if (this.scene) this.scene.updateMatrixWorld(true);
                        },

                        checkGraspPhysics: function () {
                            if (this.attachCooldown > 0) {
                                this.attachCooldown--;
                                return;
                            }

                            if (!this.leftFinger || !this.rightFinger || !this.targetBox || !this.targetBox.parent) return;

                            const leftPos = new THREE.Vector3();
                            const rightPos = new THREE.Vector3();
                            const boxPos = new THREE.Vector3();

                            this.leftFinger.getWorldPosition(leftPos);
                            this.rightFinger.getWorldPosition(rightPos);
                            this.targetBox.getWorldPosition(boxPos);

                            const graspCenter = new THREE.Vector3().addVectors(leftPos, rightPos).multiplyScalar(0.5);
                            const centerDist = graspCenter.distanceTo(boxPos);
                            const currentGrip = leftPos.distanceTo(rightPos);

                            if (this.isAttached) return;

                            if (centerDist < 0.18 && currentGrip >= 0.110 && currentGrip <= 0.145) {
                                this.isAttached = true;
                                this.eeBase.attach(this.targetBox);
                                this.targetBox.material.color.setHex(0x28a745);
                                if (this.dotNetRef) this.dotNetRef.invokeMethodAsync('OnGraspChanged', true);
                            }
                        }
                    };

                    window.ros2RobotSim.init(containerId);
                };
            ");

            await JSRuntime.InvokeVoidAsync("window.initRobotSim", "ros2-canvas", objRef);

            LogSecs("HSMS Connection Est: Controller Engine Ready", "host");
            LogSecs("S1F13: Communications Request (CR)", "host");
            LogSecs("S1F14: Communications Acknowledge (COMMACK=0)", "eq");

            await Task.Delay(100);
            await SyncToSim();
        }
    }

    [JSInvokable]
    public async Task OnSensorStreamUpdate(SensorBusPacket packet)
    {
        if (isResetting) return;

        try
        {
            if (double.IsNaN(packet.RgbdX) || double.IsNaN(packet.RgbdY) || double.IsNaN(packet.RgbdZ) || double.IsNaN(packet.RgbdYaw) ||
                double.IsNaN(packet.Enc1) || double.IsNaN(packet.Enc2) || double.IsNaN(packet.Enc3) ||
                double.IsNaN(packet.Enc4) || double.IsNaN(packet.Enc5) || double.IsNaN(packet.Enc6))
            {
                return;
            }

            encJ1 = packet.Enc1; encJ2 = packet.Enc2; encJ3 = packet.Enc3;
            encJ4 = packet.Enc4; encJ5 = packet.Enc5; encJ6 = packet.Enc6;

            realX = ekfX.Update(packet.RgbdX);
            realY = ekfY.Update(packet.RgbdY);
            realZ = ekfZ.Update(packet.RgbdZ);
            boxRotY = ekfYaw.Update(packet.RgbdYaw);

            estX = realX; estY = realY; estZ = realZ; estYaw = boxRotY;

            if (activeScenario == 3 && Math.Abs(packet.RgbdX + 0.75) < 0.20)
            {
                double nowS = NowS;
                double gap = nowS - _kfLastT;
                bool newTarget = !_kfInit || gap > 0.5;
                if (!newTarget)
                {
                    _kfY.Predict(Math.Clamp(gap, 0.001, 0.2));
                    if (Math.Abs(packet.RgbdY - _kfY.Position) > 0.15) newTarget = true;
                }

                if (newTarget)
                {
                    _kfY.Reset(packet.RgbdY, packet.BeltSpeed > 0.01 ? packet.BeltSpeed : cfg.BeltASpeedNominal);
                    _kfInit = true; _kfRejects = 0; _partSerial++;
                }
                else
                {
                    double innov = packet.RgbdY - _kfY.Position;
                    if (Math.Abs(innov) > 0.025 && _kfRejects < 4) _kfRejects++;
                    else { _kfRejects = 0; _kfY.UpdatePosition(packet.RgbdY, 2.5e-5); }
                    if (packet.BeltSpeed > 0.01) _kfY.UpdateVelocity(packet.BeltSpeed, 1e-4);
                }
                _kfLastT = nowS; _lastPacketS = nowS;
                estY = _kfY.Position; realY = estY;
            }

            tofLaserDist = packet.LaserDist;
            isPhotoelectricBroken = packet.IsBeamBroken;
            pressureLeft = packet.PressureL;
            pressureRight = packet.PressureR;

            double pitchError = Math.Abs((encJ2 + encJ3 + encJ4) - 90.0);
            if (pitchError < 3.0 && tofLaserDist > 0.01 && tofLaserDist < 0.40)
            {
                double wristWorldZ = SHOULDER_Z - L1 * Math.Sin(encJ2 * Math.PI / 180.0) - L2 * Math.Sin((encJ2 + encJ3) * Math.PI / 180.0);
                double calculatedTCP = wristWorldZ - tofLaserDist;
                if (calculatedTCP >= 0.21 && calculatedTCP <= 0.23)
                {
                    adaptiveL_TCP = adaptiveL_TCP * 0.98 + calculatedTCP * 0.02;
                }
            }
            adaptiveL_TCP = Math.Clamp(adaptiveL_TCP, 0.21, 0.23);

            if (isPhotoelectricBroken && pressureLeft > 2.0)
            {
                double measuredGround = fkTcpZ - adaptiveL_TCP;
                if (measuredGround >= 0.055 && measuredGround <= 0.065)
                {
                    adaptiveGroundZ = adaptiveGroundZ * 0.90 + measuredGround * 0.10;
                }
            }
            adaptiveGroundZ = Math.Clamp(adaptiveGroundZ, 0.055, 0.065);

            double measuredForce = Math.Max(pressureLeft, pressureRight);
            if (measuredForce > DESIRED_CONTACT_FORCE)
            {
                double forceError = measuredForce - DESIRED_CONTACT_FORCE;
                double dt = 0.01;

                double accelZ = (forceError - (ADMITTANCE_B * admittanceVelZ) - (ADMITTANCE_K * admittanceOffsetZ)) / ADMITTANCE_M;
                admittanceVelZ += accelZ * dt;
                admittanceOffsetZ += admittanceVelZ * dt;
            }
            else
            {
                admittanceVelZ *= 0.85;
                admittanceOffsetZ *= 0.85;
            }

            overlapRatio = packet.OverlapRatio;

            if (overlapRatio < MIN_OVERLAP_RATIO_LIMIT)
            {
                overlapStatus = "EDGE_RISK";
            }
            else
            {
                overlapStatus = "SAFE";
            }

            if ((DateTime.Now - _lastUiRenderTime).TotalMilliseconds >= UI_RENDER_INTERVAL_MS)
            {
                _lastUiRenderTime = DateTime.Now;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception) { }
    }

    private void ComputeForwardKinematics()
    {
        double r1 = j1Angle * Math.PI / 180.0;
        double r2 = j2Angle * Math.PI / 180.0;
        double r3 = j3Angle * Math.PI / 180.0;

        double horizontalR = L1 * Math.Cos(r2) + L2 * Math.Cos(r2 + r3);
        fkTcpX = xRailPos + (horizontalR * Math.Sin(r1));
        fkTcpY = horizontalR * Math.Cos(r1);
        fkTcpZ = SHOULDER_Z - L1 * Math.Sin(r2) - L2 * Math.Sin(r2 + r3) - adaptiveL_TCP;
    }

    private void StepFullMultibodyDynamics(double targetJ1, double targetJ2, double targetJ3, double targetJ4, double targetJ5, double targetJ6, bool isPrecisionZone = false, bool isLiftingMode = false, double dt = 0.01)
    {
        if (double.IsNaN(targetJ1) || double.IsNaN(targetJ2) || double.IsNaN(targetJ3) ||
            double.IsNaN(targetJ4) || double.IsNaN(targetJ5) || double.IsNaN(targetJ6))
        {
            return;
        }

        if (double.IsNaN(j1Angle) || double.IsNaN(j2Angle) || double.IsNaN(j3Angle) ||
            double.IsNaN(j4Angle) || double.IsNaN(j5Angle) || double.IsNaN(j6Angle))
        {
            j1Angle = FAB_HOME_J1; j2Angle = FAB_HOME_J2; j3Angle = FAB_HOME_J3;
            j4Angle = FAB_HOME_J4; j5Angle = FAB_HOME_J5; j6Angle = FAB_HOME_J6;
            w1 = 0; w2 = 0; w3 = 0; w4 = 0; w5 = 0; w6 = 0;
        }

        double maxStep = _kinematicLimits.MaxAngleJumpPerFrame;
        targetJ1 = ApplyKinematicSpeedGuard(j1Angle, targetJ1, maxStep);
        targetJ2 = ApplyKinematicSpeedGuard(j2Angle, targetJ2, maxStep);
        targetJ3 = ApplyKinematicSpeedGuard(j3Angle, targetJ3, maxStep);
        targetJ4 = ApplyKinematicSpeedGuard(j4Angle, targetJ4, maxStep);
        targetJ5 = ApplyKinematicSpeedGuard(j5Angle, targetJ5, maxStep);
        targetJ6 = ApplyKinematicSpeedGuard(j6Angle, targetJ6, maxStep);

        if (isGrasped || isPrecisionZone || isLiftingMode)
        {
            targetJ4 = 90.0 - (targetJ2 + targetJ3);
            targetJ5 = 0.0;
        }

        double targetPayload = isGrasped ? M_BOX : 0.0;
        activePayloadMass = activePayloadMass * 0.82 + targetPayload * 0.18;

        double r1 = j1Angle * Math.PI / 180.0;
        double r2 = j2Angle * Math.PI / 180.0;
        double r3 = j3Angle * Math.PI / 180.0;

        double gJ2 = (M1 * 0.4 + M2 * L1) * GRAVITY * Math.Cos(r2) + (M3 + M_EE + activePayloadMass) * GRAVITY * (L1 + L2) * Math.Cos(r2 + r3);
        double gJ3 = (M3 * 0.3 + M_EE + activePayloadMass) * GRAVITY * L2 * Math.Cos(r2 + r3);

        tauCoriolis = (M2 + M3 + M_EE) * (L1 + L2) * (w1 * w1) * Math.Sin(r2) * Math.Cos(r2);
        tauJ2 = gJ2 + tauCoriolis;
        tauJ3 = gJ3;
        tauJ1 = M1 * 0.1 * Math.Abs(w1);

        if (gripperDist <= SOLID_GRIP_LIMIT)
        {
            normalForce = NORMAL_FORCE_SOLID;
            frictionForce = 2.0 * FRICTION_MU * normalForce;

            double eccentricDistance = (1.0 - overlapRatio) * 0.12;
            tippingTorque = M_BOX * GRAVITY * eccentricDistance;

            boxPhysicsStatus = isGrasped ? "Attached" : "Slipping";
        }
        else
        {
            normalForce = 0.0; frictionForce = 0.0; tippingTorque = 0.0;
            boxPhysicsStatus = "Grounded";
        }

        double kp = isLiftingMode ? 55.0 : (isPrecisionZone ? 70.0 : (isGrasped ? 45.0 : 35.0));
        double kd = isLiftingMode ? 22.0 : (isPrecisionZone ? 24.0 : (isGrasped ? 18.0 : 16.0));
        double velDampingFactor = 0.90;

        double errJ1 = targetJ1 - j1Angle;
        double errJ2 = targetJ2 - j2Angle;
        double errJ3 = targetJ3 - j3Angle;
        double errJ4 = targetJ4 - j4Angle;
        double errJ5 = targetJ5 - j5Angle;
        double errJ6 = targetJ6 - j6Angle;

        double maxAlphaJ1 = (isPrecisionZone || activeScenario == 3) ? 180.0 : 65.0;
        double maxAlphaJ2 = isPrecisionZone ? 120.0 : 50.0;
        double maxAlphaJ3 = isPrecisionZone ? 180.0 : 90.0;
        double maxAlphaWrist = (isGrasped || isLiftingMode) ? 40.0 : 180.0;

        double alphaJ1 = Math.Clamp(kp * errJ1 - kd * w1, -maxAlphaJ1, maxAlphaJ1);
        double alphaJ2 = Math.Clamp(kp * errJ2 - kd * w2, -maxAlphaJ2, maxAlphaJ2);
        double alphaJ3 = Math.Clamp(kp * errJ3 - kd * w3, -maxAlphaJ3, maxAlphaJ3);
        double alphaJ4 = Math.Clamp(kp * errJ4 - kd * w4, -maxAlphaWrist, maxAlphaWrist);
        double alphaJ5 = Math.Clamp(kp * errJ5 - kd * w5, -maxAlphaWrist, maxAlphaWrist);
        double alphaJ6 = Math.Clamp(kp * errJ6 - kd * w6, -maxAlphaWrist, maxAlphaWrist);

        w1 += alphaJ1 * dt; w1 *= velDampingFactor;
        w2 += alphaJ2 * dt; w2 *= velDampingFactor;
        w3 += alphaJ3 * dt; w3 *= velDampingFactor;
        w4 += alphaJ4 * dt; w4 *= velDampingFactor;
        w5 += alphaJ5 * dt; w5 *= velDampingFactor;
        w6 += alphaJ6 * dt; w6 *= velDampingFactor;

        j1Angle += w1 * dt * (180.0 / Math.PI);
        j2Angle += w2 * dt * (180.0 / Math.PI);
        j3Angle += w3 * dt * (180.0 / Math.PI);
        j4Angle += w4 * dt * (180.0 / Math.PI);
        j5Angle += w5 * dt * (180.0 / Math.PI);
        j6Angle += w6 * dt * (180.0 / Math.PI);

        ComputeForwardKinematics();
    }

    private JointState EvaluateGlobalSCurveTarget(List<JointState> waypoints, double[] segDist, double totalDist, double tau)
    {
        tau = Math.Clamp(tau, 0.0, 1.0);
        double tau3 = tau * tau * tau;
        double tau4 = tau3 * tau;
        double tau5 = tau4 * tau;

        double u = 10.0 * tau3 - 15.0 * tau4 + 6.0 * tau5;

        double currentD = u * totalDist;
        double accum = 0;

        for (int i = 0; i < waypoints.Count - 1; i++)
        {
            if (currentD <= accum + segDist[i] + 0.00001 || i == waypoints.Count - 2)
            {
                double localU = (segDist[i] > 0) ? (currentD - accum) / segDist[i] : 1.0;
                localU = Math.Clamp(localU, 0.0, 1.0);
                var p1 = waypoints[i];
                var p2 = waypoints[i + 1];

                return new JointState
                {
                    J1 = p1.J1 + (p2.J1 - p1.J1) * localU,
                    J2 = p1.J2 + (p2.J2 - p1.J2) * localU,
                    J3 = p1.J3 + (p2.J3 - p1.J3) * localU,
                    J4 = p1.J4 + (p2.J4 - p1.J4) * localU,
                    J5 = p1.J5 + (p2.J5 - p1.J5) * localU,
                    J6 = p1.J6 + (p2.J6 - p1.J6) * localU,
                    Grip = p1.Grip + (p2.Grip - p1.Grip) * localU
                };
            }
            accum += segDist[i];
        }
        return waypoints.Last();
    }

    private async Task MoveAlongSCurvePathWithDynamics(List<JointState> waypoints, bool isPrecision = false, bool isLifting = false, CancellationToken ct = default)
    {
        if (waypoints.Count < 2) return;

        double[] segDist = new double[waypoints.Count - 1];
        double maxTimeReq = 0;

        for (int i = 0; i < waypoints.Count - 1; i++)
        {
            var p1 = waypoints[i];
            var p2 = waypoints[i + 1];
            double dJ1 = Math.Abs(p2.J1 - p1.J1);
            double dJ2 = Math.Abs(p2.J2 - p1.J2);
            double dJ3 = Math.Abs(p2.J3 - p1.J3);
            double dJ6 = Math.Abs(p2.J6 - p1.J6);

            double maxSpeedJ1 = isPrecision ? 45.0 : 25.0;
            double maxSpeedJ2 = isPrecision ? 35.0 : 20.0;
            double maxSpeedJ3 = isPrecision ? 50.0 : 25.0;
            double maxSpeedJ6 = isPrecision ? 120.0 : 45.0;

            double tJ1 = dJ1 / maxSpeedJ1;
            double tJ2 = dJ2 / maxSpeedJ2;
            double tJ3 = dJ3 / maxSpeedJ3;
            double tJ6 = dJ6 / maxSpeedJ6;

            double segTime = Math.Max(Math.Max(tJ1, tJ2), Math.Max(tJ3, tJ6));
            segDist[i] = segTime;
            maxTimeReq += segTime;
        }

        int steps = Math.Clamp((int)(maxTimeReq / 0.01), 60, 400);

        for (int s = 0; s <= steps; s++)
        {
            if (ct.IsCancellationRequested) return;

            double tau = (double)s / steps;
            var target = EvaluateGlobalSCurveTarget(waypoints, segDist, maxTimeReq, tau);

            StepFullMultibodyDynamics(target.J1, target.J2, target.J3, target.J4, target.J5, target.J6, isPrecisionZone: isPrecision, isLiftingMode: isLifting, dt: 0.01);
            gripperDist = target.Grip;

            await SyncToSim();
            await Task.Delay(10, ct);
        }
    }

    private async Task MoveLinearTaskSpace(double startX, double startY, double startZ, double endX, double endY, double endZ, double targetYaw, int steps = 0, CancellationToken ct = default)
    {
        double dist = Math.Sqrt(Math.Pow(endX - startX, 2) + Math.Pow(endY - startY, 2) + Math.Pow(endZ - startZ, 2));
        if (steps <= 0)
        {
            steps = Math.Clamp((int)(dist * 500.0), 60, 200);
        }

        LogSecs($"[MOTION] Linear Task Space: ({startX:F3},{startY:F3},{startZ:F3}) -> ({endX:F3},{endY:F3},{endZ:F3})", "host");

        for (int i = 1; i <= steps; i++)
        {
            if (ct.IsCancellationRequested) return;

            double t = (double)i / steps;
            double smoothT = t * t * (3.0 - 2.0 * t);

            double currX = startX + (endX - startX) * smoothT;
            double currY = startY + (endY - startY) * smoothT;
            double currZ = startZ + (endZ - startZ) * smoothT;

            if (SolveIK(currX, currY, currZ, targetYaw, out double ikJ1, out double ikJ2, out double ikJ3, out double ikJ4, out double ikJ5, out double ikJ6))
            {
                StepFullMultibodyDynamics(ikJ1, ikJ2, ikJ3, ikJ4, ikJ5, ikJ6, isPrecisionZone: true, dt: 0.01);
                await SyncToSim();
                await Task.Delay(10, ct);
            }
        }
    }

    private async Task MoveRailSlideTaskSpace(double targetRailX, int steps = 0, CancellationToken ct = default)
    {
        double startRail = xRailPos;
        double dist = Math.Abs(targetRailX - startRail);
        if (steps <= 0)
        {
            double travelTime = Math.Max(0.8, dist / 0.35);
            steps = (int)(travelTime / 0.01);
        }

        for (int i = 1; i <= steps; i++)
        {
            if (ct.IsCancellationRequested) return;
            double t = (double)i / steps;
            double smoothT = t * t * (3.0 - 2.0 * t);

            xRailPos = startRail + (targetRailX - startRail) * smoothT;
            await JSRuntime.InvokeVoidAsync("ros2SetRailX", xRailPos);

            ComputeForwardKinematics();
            await SyncToSim();
            await Task.Delay(10, ct);
        }
    }

    private async Task SmoothOpenGripperToHomeLimit(CancellationToken ct = default)
    {
        double holdJ1 = j1Angle, holdJ2 = j2Angle, holdJ3 = j3Angle, holdJ4 = j4Angle, holdJ5 = j5Angle, holdJ6 = j6Angle;
        double startGrip = gripperDist;
        int openSteps = 40;

        for (int s = 1; s <= openSteps; s++)
        {
            if (ct.IsCancellationRequested) return;

            double t = (double)s / openSteps;
            double smoothT = t * t * (3.0 - 2.0 * t);

            gripperDist = startGrip + (FAB_HOME_GRIP - startGrip) * smoothT;

            StepFullMultibodyDynamics(holdJ1, holdJ2, holdJ3, holdJ4, holdJ5, holdJ6, isPrecisionZone: true, dt: 0.01);

            await SyncToSim();
            await Task.Delay(10, ct);
        }
    }

    private bool SolveIK(double x, double y, double z, out double outJ1, out double outJ2, out double outJ3, out double outJ4, out double outJ5, out double outJ6)
    {
        return SolveIK(x, y, z, estYaw, out outJ1, out outJ2, out outJ3, out outJ4, out outJ5, out outJ6);
    }

    private bool SolveIK(double x, double y, double z, double targetWorldYaw, out double outJ1, out double outJ2, out double outJ3, out double outJ4, out double outJ5, out double outJ6)
    {
        outJ1 = 0; outJ2 = 0; outJ3 = 0; outJ4 = 0; outJ5 = 0; outJ6 = 0;

        if (double.IsNaN(x) || double.IsNaN(y) || double.IsNaN(z) || double.IsNaN(targetWorldYaw) || double.IsNaN(xRailPos))
            return false;

        double localX = x - xRailPos;

        outJ1 = Math.Atan2(localX, y) * (180.0 / Math.PI);
        if (double.IsNaN(outJ1)) outJ1 = 0;

        double wristX = localX;
        double wristY = y;
        double wristZ = z + adaptiveL_TCP + admittanceOffsetZ;

        double wristR = Math.Sqrt(wristX * wristX + wristY * wristY);
        double h = wristZ - SHOULDER_Z;
        double d = Math.Sqrt(wristR * wristR + h * h);

        if (d > (L1 + L2) || d < Math.Abs(L1 - L2) || d < 0.0001)
        {
            return false;
        }

        double cosJ3 = (d * d - L1 * L1 - L2 * L2) / (2 * L1 * L2);
        cosJ3 = Math.Clamp(cosJ3, -1.0, 1.0);
        double radJ3 = Math.Acos(cosJ3);

        double alpha = Math.Atan2(-h, wristR);
        double beta = Math.Atan2(L2 * Math.Sin(radJ3), L1 + L2 * Math.Cos(radJ3));
        double radJ2 = alpha - beta;

        outJ2 = radJ2 * (180.0 / Math.PI);
        outJ3 = radJ3 * (180.0 / Math.PI);
        outJ4 = 90.0 - (outJ2 + outJ3);
        outJ5 = 0.0;

        double nominalJ6 = outJ1 - targetWorldYaw;
        double bestJ6 = nominalJ6;
        double minDiff = Math.Abs(nominalJ6 - j6Angle);

        for (int k = -4; k <= 4; k++)
        {
            double cand = nominalJ6 + k * 90.0;
            double diff = Math.Abs(cand - j6Angle);
            if (diff < minDiff)
            {
                minDiff = diff;
                bestJ6 = cand;
            }
        }
        outJ6 = bestJ6;

        if (double.IsNaN(outJ2) || double.IsNaN(outJ3) || double.IsNaN(outJ4) || double.IsNaN(outJ5) || double.IsNaN(outJ6))
        {
            outJ1 = 0; outJ2 = 0; outJ3 = 0; outJ4 = 0; outJ5 = 0; outJ6 = 0;
            return false;
        }

        return true;
    }

    private async Task ExecuteE84HandshakeSequence(bool isPlace = false)
    {
        int jitterMs = random.Next(10, 25);
        await Task.Delay(jitterMs);

        string op = isPlace ? "[Place]" : "[Pick]";
        LogSecs($"E84 PI/O: {op} VALID=ON, CS_0=ON", "host");
        e84Valid = true; e84Cs0 = true;
        await InvokeAsync(StateHasChanged);

        for (int k = 0; k < 3; k++) { await Task.Delay(30); }

        LogSecs($"E84 PI/O: {op} L_REQ=ON, HO_AVBL=ON", "eq");
        e84LReq = true; e84HoAvbl = true;
        await InvokeAsync(StateHasChanged);

        for (int k = 0; k < 3; k++) { await Task.Delay(30); }

        LogSecs($"E84 PI/O: {op} READY=ON", "eq");
        e84Ready = true;
        await InvokeAsync(StateHasChanged);

        for (int k = 0; k < 3; k++) { await Task.Delay(30); }

        LogSecs($"E84 PI/O: {op} TR_REQ=ON, BUSY=ON", "host");
        LogSecs($"E84 PI/O: Optical transceiver active", "host");

        e84TrReq = true; e84Busy = true;

        await SetIRBeamState(true);
    }

    private async Task SetIRBeamState(bool active)
    {
        isIRBeamOn = active;
        await JSRuntime.InvokeVoidAsync("ros2SetE84IRBeam", active);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearE84Signals()
    {
        e84Valid = false; e84Cs0 = false; e84TrReq = false; e84Busy = false;
        e84Comp = false; e84Ready = false;

        await SetIRBeamState(false);
        await InvokeAsync(StateHasChanged);
    }

    private async Task SendHostCmdStartGrasp()
    {
        if (!await _simLock.WaitAsync(0)) return;

        try
        {
            isExecutingTask = true;
            _cts?.Cancel();
            _cts = new CancellationTokenSource();

            LogSecs($"S2F41 Host Command 'TRANSFER_REQ' (Job: {currentJobId})", "host");
            LogSecs("S2F42 HCACK=0", "eq");
            gemControlState = "EXECUTING";

            if (activeScenario == 1)
            {
                await PlanAndGraspWithFullPhysics(_cts.Token);
            }
            else if (activeScenario == 2)
            {
                await RunScenario2RailTransfer();
            }
        }
        catch (OperationCanceledException)
        {
            LogSecs("Task aborted via cancellation token.", "alarm");
        }
        catch (Exception ex)
        {
            LogSecs($"Exception caught during execution: {ex.Message}", "alarm");
        }
        finally
        {
            isExecutingTask = false;
            _simLock.Release();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SendHostCmdRetract()
    {
        _cts?.Cancel();
        LogSecs("S2F41 Host Command 'RETRACT'", "host");
        LogSecs("S2F42 HCACK=0", "eq");
        await ResetPose();
    }

    private async Task RandomizeScene()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        try
        {
            isResetting = true;
            isGrasped = false;
            isTransferDone = false;
            isExecutingTask = false;
            plannerStatus = "STANDBY";
            overlapRatio = 1.0;
            await ClearE84Signals();

            adaptiveL_TCP = L_TCP_NOMINAL;
            adaptiveGroundZ = GROUND_Z;
            admittanceOffsetZ = 0.0;
            admittanceVelZ = 0.0;
            activePayloadMass = 0.0;

            w1 = 0; w2 = 0; w3 = 0; w4 = 0; w5 = 0; w6 = 0;
            normalForce = 0.0; frictionForce = 0.0; tippingTorque = 0.0;

            double spawnX = 0, spawnY = 0, spawnZ = GROUND_Z;

            if (activeScenario == 1)
            {
                xRailPos = 0.0;
                double radius = 0.65 + random.NextDouble() * 0.40;
                double angleRad = (random.NextDouble() * 120.0 - 60.0) * (Math.PI / 180.0);
                spawnX = radius * Math.Sin(angleRad);
                spawnY = radius * Math.Cos(angleRad);
                spawnZ = GROUND_Z;
            }
            else if (activeScenario == 2)
            {
                xRailPos = Math.Round(random.NextDouble() * 1.8 - 0.9, 3);
                spawnX = Math.Round(random.NextDouble() * 2.2 - 1.1, 3);
                spawnY = Math.Round(0.55 + random.NextDouble() * 0.30, 3);
                spawnZ = GROUND_Z;
            }
            else if (activeScenario == 3)
            {
                xRailPos = 0.0;
                spawnX = -0.75;
                spawnY = -0.20;
                spawnZ = 0.14;
            }

            boxRotX = random.Next(-10, 10);
            boxRotY = random.Next(-60, 60);
            boxRotZ = random.Next(-10, 10);

            await JSRuntime.InvokeVoidAsync("ros2SetRailX", xRailPos);
            await JSRuntime.InvokeVoidAsync("ros2ResetBoxPose", spawnX, spawnY, spawnZ, boxRotX, boxRotY, boxRotZ);

            await Task.Delay(60);

            ekfX.Reset(spawnX);
            ekfY.Reset(spawnY);
            ekfZ.Reset(spawnZ);
            ekfYaw.Reset(boxRotY);

            if (activeScenario == 1 || activeScenario == 2)
            {
                j1Angle = random.Next(-120, 120);
                j2Angle = random.Next(-45, 20);
                j3Angle = random.Next(10, 65);
                j4Angle = random.Next(-45, 45);
                j5Angle = random.Next(-30, 30);
                j6Angle = random.Next(-60, 60);
            }
            else
            {
                j1Angle = FAB_HOME_J1;
                j2Angle = FAB_HOME_J2;
                j3Angle = FAB_HOME_J3;
                j4Angle = FAB_HOME_J4;
                j5Angle = FAB_HOME_J5;
                j6Angle = FAB_HOME_J6;
            }
            gripperDist = FAB_HOME_GRIP;

            diagnosticMessage = activeScenario == 2
                ? $"[SYS] Scenario 2 initialized. Rail X={xRailPos:F2}m, Target X={spawnX:F2}m"
                : $"[SYS] Scenario {activeScenario} initialized.";

            LogSecs($"S6F11 CEID=1000 (Scene_Initialized)", "eq");

            ComputeForwardKinematics();
            await SyncToSim();
        }
        catch (Exception ex)
        {
            LogSecs($"[SYS] Exception during initialization: {ex.Message}", "alarm");
        }
        finally
        {
            isResetting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RunScenario2RailTransfer()
    {
        LogSecs("[MOTION] Initiating multi-station transfer sequence.", "host");

        double idealRailX = Math.Clamp(estX, -1.0, 1.0);
        LogSecs($"[MOTION] Axis [Rail_X] moving to {idealRailX:F3}m", "host");
        await MoveRailSlideTaskSpace(idealRailX, steps: 0, ct: _cts.Token);

        bool graspOk = await ExecuteGraspSequence(compX: 0, compY: 0, ct: _cts.Token);

        if (graspOk)
        {
            double targetStationB_RailX = -0.8;
            LogSecs($"[MOTION] Translating to Station B (X={targetStationB_RailX:F2}m)", "host");
            await MoveRailSlideTaskSpace(targetStationB_RailX, steps: 0, ct: _cts.Token);

            double placeX = targetStationB_RailX;
            double placeY = 0.70;
            LogSecs($"[MOTION] Executing Cartesian place at Station B.", "host");

            await MoveLinearTaskSpace(fkTcpX, fkTcpY, fkTcpZ, placeX, placeY, GROUND_Z + 0.02, 0.0, steps: 0, ct: _cts.Token);

            await JSRuntime.InvokeVoidAsync("ros2ForceAttachBox", false, true);
            isGrasped = false;

            await SmoothOpenGripperToHomeLimit(ct: _cts.Token);

            await ExecuteFabStandardUnloadSequence(placeX, placeY, j1Angle, j2Angle, j3Angle, j4Angle, j5Angle, j6Angle, ct: _cts.Token);
            isTransferDone = true;
        }
    }

    private async Task ExecuteFabStandardUnloadSequence(double placeX, double placeY, double currentJ1, double currentJ2, double currentJ3, double currentJ4, double currentJ5, double currentJ6, CancellationToken ct = default)
    {
        admittanceOffsetZ = 0.0;
        admittanceVelZ = 0.0;

        double startX = fkTcpX;
        double startY = fkTcpY;
        double startZ = fkTcpZ;

        double liftZ = startZ + 0.18;
        LogSecs($"[MOTION] Z-Lift: {startZ:F3}m -> {liftZ:F3}m", "host");
        await MoveLinearTaskSpace(startX, startY, startZ, startX, startY, liftZ, estYaw, steps: 45, ct: ct);

        double radJ1 = currentJ1 * (Math.PI / 180.0);
        double exitX = startX - 0.28 * Math.Sin(radJ1);
        double exitY = startY - 0.28 * Math.Cos(radJ1);

        LogSecs($"[MOTION] Drawback XY: ({exitX:F3}, {exitY:F3})", "host");
        await MoveLinearTaskSpace(startX, startY, liftZ, exitX, exitY, liftZ, estYaw, steps: 40, ct: ct);

        LogSecs("[MOTION] Executing return to HOME.", "host");
        await ExecuteUprisingArchHomeSequence(ct: ct);
    }

    private async Task PlanAndGraspWithFullPhysics(CancellationToken ct)
    {
        isTransferDone = false;

        for (int i = 0; i < 35; i++)
        {
            if (ct.IsCancellationRequested) return;
            await Task.Delay(10, ct);
        }

        w1 = 0; w2 = 0; w3 = 0; w4 = 0; w5 = 0; w6 = 0;

        plannerStatus = "PROCESSING";
        LogSecs("S6F11 CEID=1001 (Job_Started)", "eq");
        diagnosticMessage = "Executing Cartesian approach and PBVS alignment.";
        await InvokeAsync(StateHasChanged);

        await SetIRBeamState(false);

        bool graspSuccess = await ExecuteGraspSequence(compX: 0, compY: 0, ct: ct);

        if (!graspSuccess && !ct.IsCancellationRequested)
        {
            plannerStatus = "RECOVERY";
            await SetIRBeamState(false);

            LogSecs("S5F1 ALID=501 (Edge_Grasp_Risk)", "alarm");
            LogSecs($"S6F11 CEID=1002 (Grasp_Failed)", "eq");

            diagnosticMessage = "Alarm triggered. Executing safety retract.";
            LogDetailedFailureDiagnostics("EXEC_TRY_1_FAILED");
            await InvokeAsync(StateHasChanged);

            await SmoothOpenGripperToHomeLimit(ct: ct);

            await ExecuteFabStandardUnloadSequence(fkTcpX, fkTcpY, j1Angle, j2Angle, j3Angle, j4Angle, j5Angle, j6Angle, ct: ct);
            await Task.Delay(200, ct);

            plannerStatus = "RECOVERY";
            LogSecs("S5F1 ALID=501 CLEARED", "eq");
            LogSecs("S6F11 CEID=1005 (Retry_Attempt)", "eq");

            diagnosticMessage = "Executing PBVS retry attempt.";
            await InvokeAsync(StateHasChanged);

            bool retrySuccess = await ExecuteGraspSequence(compX: 0, compY: 0, ct: ct);

            if (!retrySuccess && !ct.IsCancellationRequested)
            {
                plannerStatus = "ABORTED";
                LogSecs("S5F1 ALID=502 (Grasp_Fatal_Failure)", "alarm");
                diagnosticMessage = "Retry failed. Transfer aborted.";
                LogDetailedFailureDiagnostics("EXEC_RETRY_2_FATAL");
                gemControlState = "ALARM";
                await ClearE84Signals();
                await InvokeAsync(StateHasChanged);

                await MoveWithFullPhysicsEngine(FAB_HOME_J1, FAB_HOME_J2, FAB_HOME_J3, FAB_HOME_J4, FAB_HOME_GRIP);
            }
        }
    }

    private async Task AbortGraspAndEscapeToSafety(CancellationToken ct)
    {
        LogSecs("Interlock activated. Executing emergency Z-axis retract.", "alarm");

        await JSRuntime.InvokeVoidAsync("ros2ForceAttachBox", false, false);
        isGrasped = false;

        double startX = fkTcpX;
        double startY = fkTcpY;
        double startZ = fkTcpZ;
        double escapeZ = startZ + 0.20;

        admittanceOffsetZ = 0.0;
        admittanceVelZ = 0.0;

        await MoveLinearTaskSpace(startX, startY, startZ, startX, startY, escapeZ, estYaw, steps: 0, ct: ct);
        await ExecuteUprisingArchHomeSequence(ct: ct);
    }

    private async Task<bool> ExecuteGraspSequence(double compX = 0, double compY = 0, CancellationToken ct = default)
    {
        double ikJ1 = 0, ikJ2 = 0, ikJ3 = 0, ikJ4 = 0, ikJ5 = 0, ikJ6 = 0;
        double targetCompX = estX + compX;
        double targetCompY = estY + compY;
        double stagingZ = estZ + 0.15;

        if (SolveIK(targetCompX, targetCompY, stagingZ, estYaw, out double stageJ1, out double stageJ2, out double stageJ3, out double stageJ4, out double stageJ5, out double stageJ6))
        {
            var waypoints = new List<JointState>
            {
                new JointState { J1 = j1Angle, J2 = j2Angle, J3 = j3Angle, J4 = j4Angle, J5 = j5Angle, J6 = j6Angle, Grip = gripperDist },
                new JointState { J1 = stageJ1, J2 = stageJ2, J3 = stageJ3, J4 = stageJ4, J5 = stageJ5, J6 = stageJ6, Grip = FAB_HOME_GRIP }
            };

            await SetIRBeamState(false);
            await MoveAlongSCurvePathWithDynamics(waypoints, isPrecision: false, ct: ct);

            LogSecs("Awaiting in-position (INP) convergence.", "host");

            bool isAligned = false;
            int maxInpLoops = 60;

            for (int k = 0; k < maxInpLoops; k++)
            {
                if (ct.IsCancellationRequested) return false;

                if (SolveIK(targetCompX, targetCompY, stagingZ, estYaw, out stageJ1, out stageJ2, out stageJ3, out stageJ4, out stageJ5, out stageJ6))
                {
                    StepFullMultibodyDynamics(stageJ1, stageJ2, stageJ3, stageJ4, stageJ5, stageJ6, isPrecisionZone: true, dt: 0.01);
                }

                await SyncToSim();
                await Task.Delay(10, ct);

                double posErrXY = Math.Sqrt(Math.Pow(fkTcpX - targetCompX, 2) + Math.Pow(fkTcpY - targetCompY, 2));
                if (posErrXY < 0.003 && Math.Abs(w1) < 0.05)
                {
                    isAligned = true;
                    break;
                }
            }

            if (!isAligned)
            {
                diagnosticMessage = "ALARM: Alignment timeout. Initiating safety retract.";
                LogDetailedFailureDiagnostics("PREPAIR_ALIGNMENT_TIMEOUT");
                await AbortGraspAndEscapeToSafety(ct);
                return false;
            }

            if (activeScenario == 1)
            {
                await ExecuteE84HandshakeSequence(isPlace: false);
            }

            LogSecs("Executing Z-axis vertical approach.", "host");

            int descendSteps = 50;
            double descendStartZ = fkTcpZ;

            for (int step = 1; step <= descendSteps; step++)
            {
                if (ct.IsCancellationRequested) return false;
                eeTipZ = fkTcpZ;
                await InvokeAsync(StateHasChanged);

                if (tofLaserDist <= 0.005 || isPhotoelectricBroken) break;

                double t = (double)step / descendSteps;
                double smoothT = t * t * (3.0 - 2.0 * t);
                double currZ = descendStartZ - ((descendStartZ - estZ) * smoothT);

                if (SolveIK(targetCompX, targetCompY, currZ, estYaw, out ikJ1, out ikJ2, out ikJ3, out ikJ4, out ikJ5, out ikJ6))
                {
                    StepFullMultibodyDynamics(ikJ1, ikJ2, ikJ3, ikJ4, ikJ5, ikJ6, isPrecisionZone: true, dt: 0.01);
                }

                await SyncToSim();
                await Task.Delay(10, ct);
            }

            bool isPhysicalContactVerified = isPhotoelectricBroken && pressureLeft >= 12.0;

            if (!isPhysicalContactVerified && overlapRatio < MIN_OVERLAP_RATIO_LIMIT)
            {
                diagnosticMessage = $"ALARM: Grasp rejected (Overlap {overlapRatio:P0} < 65%). Retracting.";
                LogDetailedFailureDiagnostics("OVERLAP_RATIO_DEFICIENCY");
                await SetIRBeamState(false);
                await InvokeAsync(StateHasChanged);

                await AbortGraspAndEscapeToSafety(ct);
                return false;
            }

            double holdJ1 = j1Angle, holdJ2 = j2Angle, holdJ3 = j3Angle, holdJ4 = j4Angle, holdJ5 = j5Angle, holdJ6 = j6Angle;
            double startGrip = gripperDist;
            int pinchSteps = 24;

            for (int s = 1; s <= pinchSteps; s++)
            {
                if (ct.IsCancellationRequested) return false;

                double t = (double)s / pinchSteps;
                double smoothT = t * t * (3.0 - 2.0 * t);
                gripperDist = startGrip + (SOLID_GRIP_LIMIT - startGrip) * smoothT;

                StepFullMultibodyDynamics(holdJ1, holdJ2, holdJ3, holdJ4, holdJ5, holdJ6, isPrecisionZone: true, dt: 0.01);

                await SyncToSim();
                await Task.Delay(10, ct);
            }

            await Task.Delay(50, ct);

            if (isPhotoelectricBroken && pressureLeft >= 12.0)
            {
                await JSRuntime.InvokeVoidAsync("ros2ForceAttachBox", true, false);
                isGrasped = true;
            }

            if (tippingTorque > MAX_TIPPING_TORQUE_LIMIT)
            {
                diagnosticMessage = $"ALARM: Tipping torque exceeded limit ({tippingTorque:F2} Nm). Retracting.";
                LogDetailedFailureDiagnostics("TIPPING_TORQUE_EXCEEDED");
                await JSRuntime.InvokeVoidAsync("ros2ForceAttachBox", false, false);
                isGrasped = false;
                await SetIRBeamState(false);
                await InvokeAsync(StateHasChanged);

                await AbortGraspAndEscapeToSafety(ct);
                return false;
            }

            if (!isGrasped)
            {
                diagnosticMessage = "ALARM: Grasp verification failed. Retracting.";
                await SetIRBeamState(false);
                await InvokeAsync(StateHasChanged);

                await AbortGraspAndEscapeToSafety(ct);
                return false;
            }

            if (isGrasped)
            {
                if (activeScenario == 1) LogSecs("E84 PI/O: COMP=ON, BUSY=OFF", "host");
                diagnosticMessage = "Pick sequence complete. Initiating transfer.";
                await InvokeAsync(StateHasChanged);

                if (activeScenario == 1)
                {
                    double clearZ = fkTcpZ + 0.05;
                    double liftStartX = fkTcpX;
                    double liftStartY = fkTcpY;
                    await MoveLinearTaskSpace(liftStartX, liftStartY, fkTcpZ, liftStartX, liftStartY, clearZ, estYaw, steps: 0, ct: ct);

                    double placeX = 0, placeY = 0;
                    double targetJ1 = ikJ1, targetJ2 = ikJ2, targetJ3 = ikJ3, targetJ4 = ikJ4, targetJ5 = ikJ5, targetJ6 = ikJ6;
                    bool ikSolved = false;
                    for (int k = 0; k < 30; k++)
                    {
                        double r = 0.60 + random.NextDouble() * 0.45;
                        double ang = (random.NextDouble() * 240.0 - 120.0) * (Math.PI / 180.0);
                        placeX = r * Math.Sin(ang);
                        placeY = r * Math.Cos(ang);
                        if (SolveIK(placeX, placeY, GROUND_Z, 0.0, out targetJ1, out targetJ2, out targetJ3, out targetJ4, out targetJ5, out targetJ6))
                        {
                            ikSolved = true;
                            break;
                        }
                    }
                    if (!ikSolved)
                    {
                        targetJ1 = ikJ1 + 90.0;
                        targetJ2 = ikJ2; targetJ3 = ikJ3; targetJ4 = ikJ4; targetJ5 = ikJ5; targetJ6 = ikJ6;
                    }

                    LogSecs($"Executing CP transport to X={placeX:F2}, Y={placeY:F2}.", "host");
                    diagnosticMessage = "Executing CP trajectory.";
                    await InvokeAsync(StateHasChanged);

                    await ExecuteE84HandshakeSequence(isPlace: true);

                    SolveIK(placeX, placeY, clearZ, 0.0, out double pStgJ1, out double pStgJ2, out double pStgJ3, out double pStgJ4, out double pStgJ5, out double pStgJ6);

                    var cpWaypoints = new List<JointState>
                    {
                        new JointState { J1 = j1Angle, J2 = j2Angle, J3 = j3Angle, J4 = j4Angle, J5 = ikJ5, J6 = ikJ6, Grip = SOLID_GRIP_LIMIT },
                        new JointState { J1 = pStgJ1, J2 = pStgJ2, J3 = pStgJ3, J4 = pStgJ4, J5 = pStgJ5, J6 = pStgJ6, Grip = SOLID_GRIP_LIMIT }
                    };

                    await MoveAlongSCurvePathWithDynamics(cpWaypoints, isPrecision: true, isLifting: true, ct: ct);

                    LogSecs("Awaiting in-position (INP) convergence for place.", "host");
                    for (int k = 0; k < 10; k++)
                    {
                        if (ct.IsCancellationRequested) return false;
                        StepFullMultibodyDynamics(pStgJ1, pStgJ2, pStgJ3, pStgJ4, pStgJ5, pStgJ6, isPrecisionZone: true, dt: 0.01);
                        await SyncToSim();
                        await Task.Delay(10, ct);
                    }

                    LogSecs("Executing Z-axis vertical place.", "host");

                    double placeDescendStartX = fkTcpX;
                    double placeDescendStartY = fkTcpY;
                    await MoveLinearTaskSpace(placeDescendStartX, placeDescendStartY, fkTcpZ, placeDescendStartX, placeDescendStartY, GROUND_Z, 0.0, steps: 0, ct: ct);

                    await JSRuntime.InvokeVoidAsync("ros2ForceAttachBox", false, true);
                    isGrasped = false;

                    await SmoothOpenGripperToHomeLimit(ct: ct);

                    LogSecs("S6F11 CEID=1006 (Place_Completed)", "eq");
                    diagnosticMessage = "Place complete. Executing retract sequence.";
                    await InvokeAsync(StateHasChanged);

                    await ExecuteFabStandardUnloadSequence(placeDescendStartX, placeDescendStartY, j1Angle, j2Angle, j3Angle, j4Angle, j5Angle, j6Angle, ct: ct);

                    await Task.Delay(100, ct);
                    await ClearE84Signals();
                    LogSecs("E84 PI/O: Transfer complete. Optical transceiver off.", "host");

                    plannerStatus = "STANDBY";
                    gemControlState = "REMOTE";
                    isTransferDone = true;
                }
                return true;
            }
        }
        else
        {
            await AbortGraspAndEscapeToSafety(ct);
        }
        return false;
    }

    private async Task ExecuteUprisingArchHomeSequence(CancellationToken ct = default)
    {
        var startPose = new JointState {
            J1 = j1Angle, J2 = j2Angle, J3 = j3Angle, J4 = j4Angle, J5 = j5Angle, J6 = j6Angle, Grip = gripperDist
        };

        var homePose = new JointState {
            J1 = FAB_HOME_J1, J2 = FAB_HOME_J2, J3 = FAB_HOME_J3, J4 = FAB_HOME_J4, J5 = FAB_HOME_J5, J6 = FAB_HOME_J6, Grip = FAB_HOME_GRIP
        };

        var archWaypoints = new List<JointState>
        {
            startPose,
            homePose
        };

        LogSecs("[Motion] Initiating HOME trajectory.", "host");
        await MoveAlongSCurvePathWithDynamics(archWaypoints, isPrecision: false, isLifting: false, ct: ct);
    }

    private async Task ResetPose()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        w1 = 0; w2 = 0; w3 = 0; w4 = 0; w5 = 0; w6 = 0;
        admittanceOffsetZ = 0.0; admittanceVelZ = 0.0;
        LogSecs("S6F11 CEID=1004 (Robot_At_Home)", "eq");
        await ClearE84Signals();

        try
        {
            await ExecuteUprisingArchHomeSequence(_cts.Token);
        }
        catch (OperationCanceledException) { }

        plannerStatus = "STANDBY";
        gemControlState = "REMOTE";
        isGrasped = false;
        diagnosticMessage = "Robot at HOME position.";
    }

    private async Task MoveWithFullPhysicsEngine(double targetJ1, double targetJ2, double targetJ3, double targetJ4, double targetGrip)
    {
        double startGrip = gripperDist;
        int steps = 50;

        for (int i = 1; i <= steps; i++)
        {
            double t = (double)i / steps;
            double smoothGrip = startGrip + (targetGrip - startGrip) * (t * t * (3 - 2 * t));
            gripperDist = smoothGrip;

            StepFullMultibodyDynamics(targetJ1, targetJ2, targetJ3, targetJ4, 0, 0, isPrecisionZone: false, dt: 0.01);

            await SyncToSim();
            await Task.Delay(10);
        }
    }

    private async Task SyncToSim()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("ros2SetJointState", j1Angle, j2Angle, j3Angle, j4Angle, j5Angle, j6Angle, gripperDist);
        }
        catch (Exception) { }
    }

