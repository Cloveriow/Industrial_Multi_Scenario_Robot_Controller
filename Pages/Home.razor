    private void LogCeid(int ceid, string name, string rpt = "")
        => LogSecs($"S6F11 CEID={ceid} ({name})" + (rpt.Length > 0 ? " RPT: " + rpt : ""), "eq");

    private void SetCell(CellState s)
    {
        if (cellState == s) return;
        var prev = cellState; cellState = s;
        LogSecs($"S6F11 CEID=3100 (State_Change) PREV={prev} NEW={s}", "eq");
    }

    private void RaiseAlarm(int alid, string text)
    {
        cellAlarms++; _activeAlid = alid;
        diagnosticMessage = $"ALARM {alid}: {text}";
        LogSecs($"S5F1 ALID={alid} ALCD=86 ({text})", "alarm");
    }

    private void ClearAlarm()
    {
        if (_activeAlid == 0) return;
        LogSecs($"S5F1 ALID={_activeAlid} ALCD=00 CLEARED", "eq");
        _activeAlid = 0;
    }

    private async Task Scenario3HostCmd(string rcmd)
    {
        int hcack = 0;
        LogSecs($"S2F41 Host Command '{rcmd}'", "host");
        bool running = !_cellTask.IsCompleted;

        switch (rcmd)
        {
            case "START":
                if (running || activeScenario != 3) { hcack = 2; break; }
                _stopReq = false; _pauseReq = false;
                _kfInit = false; _handledSerial = _partSerial;
                cellPicked = 0; cellMissed = 0; cellSkipped = 0; cellAlarms = 0; _activeAlid = 0;
                _cts ??= new CancellationTokenSource();
                _cellCts = CancellationTokenSource.CreateLinkedTokenSource(_cts.Token);
                var token = _cellCts.Token;
                _cellTask = Task.Run(() => RunScenario3Cell(token));
                break;
            case "PAUSE":
                if (!running || _pauseReq) hcack = 2; else _pauseReq = true;
                break;
            case "RESUME":
                if (!running || !_pauseReq) hcack = 2; else _pauseReq = false;
                break;
            case "STOP":
                if (!running) hcack = 2; else { _stopReq = true; _pauseReq = false; }
                break;
            case "ABORT":
                _cellCts?.Cancel();
                try { await _cellTask; } catch (Exception) { }
                if (isGrasped)
                {
                    await JSRuntime.InvokeVoidAsync("ros2ForceAttachBox", false, false);
                    isGrasped = false;
                    RaiseAlarm(3006, "Part_Held_At_Abort");
                }
                _pauseReq = false; _stopReq = false;
                await ResetPose();
                break;
            default:
                hcack = 1; break;
        }
        LogSecs($"S2F42 HCACK={hcack}", hcack == 0 ? "eq" : "alarm");
    }

    private async Task RunScenario3Cell(CancellationToken ct)
    {
        try
        {
            _runStartS = NowS;
            gemControlState = "EXECUTING";
            LogCeid(3101, "AutoRun_Started");
            LogSecs($"S2F14 ECV PickWindowY=[{cfg.PickWindowUpY:F2},{cfg.PickWindowDownY:F2}]m SpeedScale={cfg.SpeedScale:F2}", "eq");
            bool atStandby = false;

            while (!ct.IsCancellationRequested && activeScenario == 3 && !_stopReq)
            {
                if (_pauseReq)
                {
                    SetCell(CellState.Paused);
                    while (_pauseReq && !_stopReq) await Task.Delay(100, ct);
                    continue;
                }

                var chk = CheckPendingPart();
                if (chk == PartCheck.Missed)
                {
                    _handledSerial = _partSerial;
                    cellMissed++;
                    LogCeid(3008, "Part_Missed_Window", $"Y={PredictY(NowS):F3}m");
                }
                else if (chk == PartCheck.Ready)
                {
                    _handledSerial = _partSerial;
                    isExecutingTask = true;
                    try { await RunScenario3Cycle(ct); }
                    finally { isExecutingTask = false; }
                    atStandby = false;
                }
                else
                {
                    SetCell(CellState.Waiting);
                    if (!atStandby) { await MoveToStandby(ct); atStandby = true; SetCell(CellState.Waiting); }
                    else await Task.Delay(15, ct);
                }
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { RaiseAlarm(3099, $"Cell_Exception: {ex.Message}"); }
        finally
        {
            SetCell(CellState.Idle);
            gemControlState = "REMOTE";
            LogCeid(3102, "AutoRun_Stopped", $"Picked={cellPicked} Skipped={cellSkipped} Missed={cellMissed}");
        }
    }

    private PartCheck CheckPendingPart()
    {
        if (_partSerial == _handledSerial) return PartCheck.None;
        if (NowS - _lastPacketS > 0.15) return PartCheck.None;
        if (Math.Abs(estX + 0.75) > 0.20) return PartCheck.None;
        double y = PredictY(NowS);
        if (y > cfg.PickWindowDownY) return PartCheck.Missed;
        return y >= cfg.PickWindowUpY ? PartCheck.Ready : PartCheck.None;
    }

    private bool PartStillAvailable()
    {
        if (_partSerial != _handledSerial) return false;
        if (NowS - _lastPacketS > 0.15) return false;
        double y = PredictY(NowS);
        return y >= cfg.PickWindowUpY && y <= cfg.PickWindowDownY - BeltV * 1.0;
    }

    private async Task RunScenario3Cycle(CancellationToken ct)
    {
        double tStart = NowS;
        string partId = $"WFR_{++_partSeq:0000}";
        LogCeid(3001, "Part_Detected", $"PartID={partId} Y={estY:F3}m");

        int attempt = 0;
        while (true)
        {
            var res = await TrackedPick(partId, ct);
            if (res == PickResult.Ok) break;
            if (res == PickResult.Unreachable) { cellSkipped++; return; }

            attempt++;
            if (attempt > cfg.MaxRetry || !PartStillAvailable())
            {
                cellMissed++;
                RaiseAlarm(3001, $"Pick_Failed PartID={partId}");
                return;
            }
            LogCeid(3007, "Pick_Retry", $"PartID={partId} Attempt={attempt + 1}");
        }

        await FlyingPlace(partId, ct);
        cellPicked++;
        _lastCycleS = NowS - tStart;
        ClearAlarm();
        LogCeid(3010, "Cycle_Complete", $"PartID={partId} CycleTime={_lastCycleS:F2}s");
    }

    private static double MinJerk(double s) => s * s * s * (10.0 - 15.0 * s + 6.0 * s * s);

    private JointState CurrentJoints() => new JointState
    {
        J1 = j1Angle, J2 = j2Angle, J3 = j3Angle, J4 = j4Angle, J5 = j5Angle, J6 = j6Angle, Grip = gripperDist
    };

    private static JointState ToJoints(double j1, double j2, double j3, double j4, double j5, double j6, double grip) => new JointState
    {
        J1 = j1, J2 = j2, J3 = j3, J4 = j4, J5 = j5, J6 = j6, Grip = grip
    };

    private double EstimateMoveTime(JointState a, JointState b)
    {
        double k = Math.Max(0.2, cfg.SpeedScale);
        double t = Math.Max(
            Math.Max(Math.Abs(b.J1 - a.J1) / (S3_PEAK_J1 * k), Math.Abs(b.J2 - a.J2) / (S3_PEAK_J2 * k)),
            Math.Max(Math.Abs(b.J3 - a.J3) / (S3_PEAK_J3 * k), Math.Abs(b.J6 - a.J6) / (S3_PEAK_J6 * k)));
        return Math.Max(0.30, t * 1.875);
    }

    private async Task MoveJointsTimed(List<JointState> wps, CancellationToken ct)
    {
        double[] seg = new double[wps.Count - 1];
        double total = 0;
        for (int i = 0; i < seg.Length; i++) { seg[i] = EstimateMoveTime(wps[i], wps[i + 1]); total += seg[i]; }

        double t0 = NowS, last = t0;
        while (true)
        {
            ct.ThrowIfCancellationRequested();
            double now = NowS;
            double tau = Math.Clamp((now - t0) / total, 0.0, 1.0);
            var tg = EvaluateGlobalSCurveTarget(wps, seg, total, tau);
            int sub = Math.Clamp((int)Math.Round((now - last) / 0.01), 1, 4);
            last = now;
            for (int i = 0; i < sub; i++)
                StepFullMultibodyDynamics(tg.J1, tg.J2, tg.J3, tg.J4, tg.J5, tg.J6, isPrecisionZone: true, dt: 0.01);
            gripperDist = tg.Grip;
            await SyncToSim();
            if (tau >= 1.0) break;
            await Task.Delay(8, ct);
        }
    }

    private async Task<bool> RunTrackedPhase(
        double duration,
        Func<double, double, (double x, double y, double z)> target,
        double yawDeg, bool liveYaw, bool lifting, CancellationToken ct,
        Func<double, double> gripAt = null, Func<bool> earlyExit = null)
    {
        double t0 = NowS, last = t0;
        double yawCmd = liveYaw ? estYaw : yawDeg;
        int ikFail = 0;

        while (true)
        {
            ct.ThrowIfCancellationRequested();
            double now = NowS;
            double s = Math.Clamp((now - t0) / duration, 0.0, 1.0);
            if (liveYaw) yawCmd = yawCmd * 0.9 + estYaw * 0.1; 

            var (tx, ty, tz) = target(s, now);
            if (SolveIK(tx, ty, tz, yawCmd, out double a, out double b, out double c, out double d, out double e, out double f))
            {
                ikFail = 0;
                int sub = Math.Clamp((int)Math.Round((now - last) / 0.01), 1, 4);
                for (int i = 0; i < sub; i++)
                    StepFullMultibodyDynamics(a, b, c, d, e, f, isPrecisionZone: true, isLiftingMode: lifting, dt: 0.01);
            }
            else if (++ikFail > 15) return false;

            last = now;
            if (gripAt != null) gripperDist = gripAt(s);
            await SyncToSim();

            if (earlyExit != null && earlyExit()) return true;
            if (s >= 1.0) return true;
            await Task.Delay(8, ct);
        }
    }

    private InterceptPlan PlanIntercept()
    {
        var cur = CurrentJoints();
        double v = BeltV, x = estX, z = estZ + 0.15, T = 0.6;
        JointState stage = cur;

        for (int it = 0; it < 6; it++)
        {
            double stageY = PredictY(NowS + T) - cfg.UpstreamMarginM;
            if (!SolveIK(x, stageY, z, estYaw, out double a, out double b, out double c, out double d, out double e, out double f))
                return new InterceptPlan { Feasible = false, Reason = $"IK_UNREACHABLE" };

            stage = ToJoints(a, b, c, d, e, f, FAB_HOME_GRIP);
            double Tn = EstimateMoveTime(cur, stage);
            bool converged = Math.Abs(Tn - T) < 0.02;
            T = Tn;
            if (converged) break;
        }

        double yArr = PredictY(NowS + T);
        double pickDur = cfg.SyncTimeS + cfg.DescendTimeS + cfg.PinchTimeS + cfg.LiftTimeS;
        if (yArr + v * pickDur > cfg.PickWindowDownY)
            return new InterceptPlan { Feasible = false, Reason = $"TIME_DEFICIT" };

        return new InterceptPlan { Feasible = true, T = T, YArrival = yArr, Stage = stage };
    }

    private async Task MoveToStandby(CancellationToken ct)
    {
        SetCell(CellState.Returning);
        if (!SolveIK(-0.75, cfg.StandbyY, cfg.StandbyZ, 0.0, out double a, out double b, out double c, out double d, out double e, out double f))
        {
            RaiseAlarm(3011, "Standby_IK_Fail");
            return;
        }
        await MoveJointsTimed(new List<JointState> { CurrentJoints(), ToJoints(a, b, c, d, e, f, FAB_HOME_GRIP) }, ct);
        LogCeid(3004, "Arm_At_Standby");
    }

    private async Task PickEscape(double px, Func<double, double> refY, double zFrom, CancellationToken ct)
    {
        double g0 = gripperDist, yawLock = estYaw;
        await RunTrackedPhase(0.30, (s, t) => (px, refY(t), zFrom + 0.15 * MinJerk(s)),
            yawLock, false, false, ct, gripAt: s => g0 + (FAB_HOME_GRIP - g0) * MinJerk(s));
    }

    private async Task<PickResult> TrackedPick(string partId, CancellationToken ct)
    {
        SetCell(CellState.Intercept);
        admittanceOffsetZ = 0.0; admittanceVelZ = 0.0;

        var plan = PlanIntercept();
        if (!plan.Feasible)
        {
            LogCeid(3008, "Part_Skipped_Unreachable", $"PartID={partId}");
            return PickResult.Unreachable;
        }
        
        await MoveJointsTimed(new List<JointState> { CurrentJoints(), plan.Stage }, ct);

        SetCell(CellState.Sync);
        double px = estX, stageZ = estZ + 0.15;
        double offX = fkTcpX - px, offY = fkTcpY - PredictY(NowS);
        bool ok = await RunTrackedPhase(cfg.SyncTimeS,
            (s, t) => { double k = 1.0 - MinJerk(s); return (px + offX * k, PredictY(t) + offY * k, stageZ); },
            0, true, false, ct);

        double err = Math.Sqrt(Math.Pow(fkTcpX - px, 2) + Math.Pow(fkTcpY - PredictY(NowS), 2));
        if (!ok || err > 0.008)
        {
            ok = await RunTrackedPhase(0.30, (s, t) => (px, PredictY(t), stageZ), 0, true, false, ct);
            err = Math.Sqrt(Math.Pow(fkTcpX - px, 2) + Math.Pow(fkTcpY - PredictY(NowS), 2));
            if (!ok || err > 0.008)
            {
                LogCeid(3009, "Sync_Timeout", $"PartID={partId}");
                return PickResult.Failed;
            }
        }
        _trackErrMm = err * 1000.0;

        SetCell(CellState.Picking);
        double z0 = fkTcpZ, zg = estZ;
        await RunTrackedPhase(cfg.DescendTimeS,
            (s, t) => (px, PredictY(t), z0 + (zg - z0) * MinJerk(s)),
            0, true, false, ct, earlyExit: () => pressureLeft > 20.0 || pressureRight > 20.0);

        double tRef = NowS, yRef0 = PredictY(tRef), vRef = BeltV, yawLock = estYaw;
        Func<double, double> refY = t => yRef0 + vRef * (t - tRef);

        bool contact = isPhotoelectricBroken && pressureLeft >= 12.0;
        if (!contact && overlapRatio < MIN_OVERLAP_RATIO_LIMIT)
        {
            RaiseAlarm(3002, $"Edge_Grasp_Risk");
            LogDetailedFailureDiagnostics("S3_OVERLAP_DEFICIENCY");
            await PickEscape(px, refY, zg, ct);
            return PickResult.Failed;
        }

        double g0 = gripperDist;
        await RunTrackedPhase(cfg.PinchTimeS, (s, t) => (px, refY(t), zg),
            yawLock, false, false, ct, gripAt: s => g0 + (SOLID_GRIP_LIMIT - g0) * MinJerk(s));
        await RunTrackedPhase(0.06, (s, t) => (px, refY(t), zg), yawLock, false, false, ct);

        if (isPhotoelectricBroken && pressureLeft >= 12.0)
        {
            await JSRuntime.InvokeVoidAsync("ros2ForceAttachBox", true, false);
            isGrasped = true;
        }

        if (!isGrasped || tippingTorque > MAX_TIPPING_TORQUE_LIMIT)
        {
            RaiseAlarm(3003, isGrasped ? $"Tipping_Torque_High" : "Grip_Not_Confirmed");
            LogDetailedFailureDiagnostics("S3_GRIP_VERIFY");
            await JSRuntime.InvokeVoidAsync("ros2ForceAttachBox", false, false);
            isGrasped = false;
            await PickEscape(px, refY, zg, ct);
            return PickResult.Failed;
        }

        await RunTrackedPhase(cfg.LiftTimeS, (s, t) => (px, refY(t), zg + 0.14 * MinJerk(s)),
            yawLock, false, true, ct);

        LogCeid(3003, "Part_Picked", $"PartID={partId}");
        return PickResult.Ok;
    }

    private async Task FlyingPlace(string partId, CancellationToken ct)
    {
        SetCell(CellState.Transfer);
        double vB = BeltV;                                    
        double stageZ = cfg.PlaceZ + 0.15;
        double xArr = cfg.PlaceX - vB * (cfg.SyncTimeS + cfg.DescendTimeS);

        if (!SolveIK(xArr, cfg.PlaceY, stageZ, 0.0, out double a, out double b, out double c, out double d, out double e, out double f))
        {
            RaiseAlarm(3004, "Place_IK_Fail");
            await JSRuntime.InvokeVoidAsync("ros2ForceAttachBox", false, false);
            isGrasped = false;
            return;
        }

        var cur = CurrentJoints();
        var stage = ToJoints(a, b, c, d, e, f, SOLID_GRIP_LIMIT);
        double T = EstimateMoveTime(cur, stage);
        double tRel = NowS + T + cfg.SyncTimeS + cfg.DescendTimeS;      
        Func<double, double> slotX = t => cfg.PlaceX + vB * (t - tRel);

        await MoveJointsTimed(new List<JointState> { cur, stage }, ct);

        SetCell(CellState.Placing);
        double offX = fkTcpX - slotX(NowS), offY = fkTcpY - cfg.PlaceY;
        await RunTrackedPhase(cfg.SyncTimeS,
            (s, t) => { double k = 1.0 - MinJerk(s); return (slotX(t) + offX * k, cfg.PlaceY + offY * k, stageZ); },
            0.0, false, true, ct);

        double z0 = fkTcpZ;
        await RunTrackedPhase(cfg.DescendTimeS,
            (s, t) => (slotX(t), cfg.PlaceY, z0 + (cfg.PlaceZ - z0) * MinJerk(s)),
            0.0, false, true, ct);

        await JSRuntime.InvokeVoidAsync("ros2ForceAttachBox", false, true);
        isGrasped = false;
        LogCeid(3006, "Part_Placed", $"PartID={partId}");

        double g0 = gripperDist;
        await RunTrackedPhase(0.25, (s, t) => (slotX(t), cfg.PlaceY, cfg.PlaceZ),
            0.0, false, false, ct, gripAt: s => g0 + (FAB_HOME_GRIP - g0) * MinJerk(s));
        await RunTrackedPhase(0.25, (s, t) => (slotX(t), cfg.PlaceY, cfg.PlaceZ + 0.15 * MinJerk(s)),
            0.0, false, false, ct, gripAt: s => FAB_HOME_GRIP);
    }


    public async ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _cellCts?.Cancel();
        try { await JSRuntime.InvokeVoidAsync("ros2Dispose"); } catch (Exception) { }
        _simLock.Dispose();
        if (objRef != null)
        {
            objRef.Dispose();
        }
    }
}

