@page "/"
@using Microsoft.JSInterop
@using System.Globalization
@using System.Threading
@using System.Threading.Tasks
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="ros2-sim-wrapper">
    <!-- 主 3D 模擬與控制面板區塊 -->
    <div class="ros2-sim-container">
        <div class="canvas-section">
            <div id="ros2-canvas" class="canvas-area"></div>
            <div class="overlay-info">
                <span class="badge ros-badge">Scenario: @activeScenarioName</span>
                <span class="badge-topic">Planner: @plannerStatus</span>
            </div>
            <!-- 🖱️ 左下角滑鼠 3D 世界座標顯示區 (ROS 2 Z-Up 標準: X: Rail, Y: Conveyor, Z: Height) -->
            <div class="overlay-bottom-left">
                <span id="mouse-coords" class="badge-topic mouse-badge">🖱️ ROS2 World (Z-Up): (X: 0.000, Y: 0.000, Z: 0.000)m</span>
            </div>
        </div>

        <div class="control-section">
            <div class="panel-header">
                <h2>🦾 Industrial Multi-Scenario Robot Controller</h2>
                <p>SEMI E84 Cleanroom | 7-DOF Linear Rail | Fully-Auto Conveyor Tracking</p>
            </div>

            <!-- 🎛️ 情境切換頁籤 (Scenario Switcher) -->
            <div class="scenario-tabs">
                <button class="@(activeScenario == 1 ? "tab-btn active" : "tab-btn")" @onclick="() => SwitchScenario(1)">1. SEMI E84 晶圓</button>
                <button class="@(activeScenario == 2 ? "tab-btn active" : "tab-btn")" @onclick="() => SwitchScenario(2)">2. 7-DOF 橫向滑軌</button>
                <button class="@(activeScenario == 3 ? "tab-btn active" : "tab-btn")" @onclick="() => SwitchScenario(3)">3. 雙輸送帶追蹤</button>
            </div>

            <hr />

            <!-- 🚥 情境 1 專用：SEMI E84 PI/O 硬體信號燈號 -->
            @if (activeScenario == 1)
            {
                <div class="e84-signal-box">
                    <div class="e84-title">🚥 SEMI E84 PI/O Signal Status</div>
                    <div class="e84-grid">
                        <div class="@GetE84Class(e84Valid)">VALID</div>
                        <div class="@GetE84Class(e84Cs0)">CS_0</div>
                        <div class="@GetE84Class(e84TrReq)">TR_REQ</div>
                        <div class="@GetE84Class(e84Busy)">BUSY</div>
                        <div class="@GetE84Class(e84Comp)">COMP</div>
                        <div class="@GetE84Class(e84LReq, "active-passive")">L_REQ</div>
                        <div class="@GetE84Class(e84Ready, "active-passive")">READY</div>
                        <div class="@GetE84Class(e84HoAvbl, "active-passive")">HO_AVBL</div>
                    </div>
                </div>

                <div class="ik-input-box">
                    <h4>📡 1. SECS/GEM + SEMI E84 Trigger</h4>
                    <div class="host-btn-grid">
                        <button class="btn-sec-cmd" @onclick="SendHostCmdStartGrasp" style="background:#d90429;" disabled="@isExecutingTask">S2F41: STRESS_TEST</button>
                        <button class="btn-sec-cmd" @onclick="SendHostCmdRetract">S2F41: RETRACT</button>
                    </div>
                    <button class="btn-scramble" style="margin-top:5px;" @onclick="RandomizeScene">🎲 生成新晶圓 + J1~J6 隨機化</button>
                </div>
            }
            else if (activeScenario == 2)
            {
                <!-- 🚊 情境 2 專用：7-DOF 橫向導軌控制面板 -->
                <div class="ik-input-box">
                    <h4>🚊 2. 7-DOF Linear Rail Multi-Station Transfer</h4>
                    <div class="host-btn-grid">
                        <button class="btn-sec-cmd" @onclick="SendHostCmdStartGrasp" style="background:#007acc;" disabled="@isExecutingTask">🚀 發動 7-DOF 跨站點移載</button>
                        <button class="btn-sec-cmd" @onclick="SendHostCmdRetract">HOME 歸位</button>
                    </div>
                    <div class="debug-row" style="margin-top:4px;"><b>導軌 X 位置 (Rail X):</b> <span style="color:#00ffcc; font-weight:bold;">@xRailPos.ToString("F3") m</span></div>
                    <button class="btn-scramble" style="margin-top:5px;" @onclick="RandomizeScene">🎲 滑軌 + 物體重置</button>
                </div>
            }
            else if (activeScenario == 3)
            {
                <!-- 🏭 情境 3 專用：全自動雙輸送帶追蹤控制面板 -->
                <div class="ik-input-box">
                    <h4>🏭 3. Fully-Automated Conveyor Tracking & Transfer</h4>
                    <div class="debug-row" style="margin-top:2px;"><b>運作模式:</b> <span style="color:#28a745; font-weight:bold;">🟢 CEID 1010 絕對鎖相磁浮追蹤 (Absolute Phase-Lock)</span></div>
                    <div class="debug-row"><b>Belt A (進料速度):</b> <span style="color:#00ffcc">0.12 m/s (無感測躍變，防瞬移)</span></div>
                    <div class="debug-row"><b>Belt B (出料速度):</b> <span style="color:#00ffcc">0.12 m/s (自動擺正回收)</span></div>
                    <div class="debug-row"><b>進料感測:</b> <span style="color:#ffb703">Y=-0.60m 門相機預測 (拒絕滯後追空)</span></div>
                    <button class="btn-scramble" style="margin-top:5px;" @onclick="SendHostCmdRetract">⏸ 緊急停止 / 重置歸位</button>
                </div>
            }

            <!-- 實時自適應參數與感測器監控面板 -->
            <div class="debug-panel">
                <div class="debug-row"><b>設備狀態:</b> <span style="color:#00d2ff">@gemControlState</span></div>
                <div class="debug-row"><b>📡 移載規程:</b> <span style="color:#00d2ff">Cycle-Time 動態預測 ➜ 零滯後無縫貼合</span></div>
                <div class="debug-row"><b>🔄 閥門保護 TCP 偏距 (L_TCP):</b> <span style="color:#00ffcc; font-weight:bold;">@adaptiveL_TCP.ToString("F4") m</span></div>
                <div class="debug-row"><b>🛡️ 導納力控退讓量 (Admittance Z):</b> <span style="color:#ffb703; font-weight:bold;">@admittanceOffsetZ.ToString("F4") m</span></div>
                <div class="debug-row"><b>📷 RGB-D EKF 姿態估算:</b> <span style="color:#ffb703">(<span style="color:#00d2ff">@estX.ToString("F3")</span>, <span style="color:#00d2ff">@estY.ToString("F3")</span>, <span style="color:#00d2ff">@estZ.ToString("F3")</span>) Yaw:<span style="color:#00d2ff">@estYaw.ToString("F1")°</span></span></div>
                <div class="debug-row"><b>🎯 真實物體真值 (GT):</b> <span style="color:#00ffcc">(<span style="color:#00ffcc">@gtX.ToString("F3")</span>, <span style="color:#00ffcc">@gtY.ToString("F3")</span>, <span style="color:#00ffcc">@gtZ.ToString("F3")</span>) Yaw:<span style="color:#00ffcc">@gtYaw.ToString("F1")°</span></span></div>
                <div class="debug-row"><b>指墊觸覺壓力:</b> <span style="color:#28a745">L: @pressureLeft.ToString("F1") kPa / R: @pressureRight.ToString("F1") kPa</span></div>
                <div class="debug-row highlight"><b>運動學推算 TCP (FK Z-Up):</b> (<span style="color:#00ffcc">@fkTcpX.ToString("F3")</span>, <span style="color:#00ffcc">@fkTcpY.ToString("F3")</span>, <span style="color:#00ffcc">@fkTcpZ.ToString("F3")</span>)</div>
                <div class="debug-row"><b>絕對編碼器 (Enc J1-J6):</b> @encJ1.ToString("F0")° / @encJ2.ToString("F0")° / @encJ3.ToString("F0")° / @encJ4.ToString("F0")° / @encJ5.ToString("F0")° / @encJ6.ToString("F0")°</div>
                <div class="debug-row"><b>系統診斷:</b> @diagnosticMessage</div>
            </div>

            <!-- 📜 SECS-II / Transfer Log Console (擴展至 160px，無遮擋視野) -->
            <div class="sec-console" style="height: 160px;">
                <div class="console-title">📜 SECS-II / Transfer Log</div>
                <div class="console-body">
                    @foreach (var log in secsLogs)
                    {
                        <div class="console-line @log.StyleClass">@log.Text</div>
                    }
                </div>
            </div>

            <div class="@GraspStatusClass" style="margin-top: 6px;">
                <span>🎯 最終結果：<b>@(isTransferDone ? "✅ 當前情境直拿直放移載作業完美完成！" : "⏳ 等待指令觸發")</b></span>
            </div>
        </div>
    </div>

    <!-- 📷 512x512 高解析度第一人稱視野 HUD -->
    <div class="rgbd-preview-container">
        <div class="rgbd-header">
            <span>📷 Eye-in-Hand RGB-D Point-of-View (512x512 Sensor Stream)</span>
            <span class="rgbd-status">LIVE | 30FPS Real-time CMOS Noise</span>
        </div>
        <div class="rgbd-viewport">
            <div id="rgbd-canvas" class="rgbd-canvas-area"></div>
            <div class="sensor-noise-overlay"></div>
            <div class="sensor-scanlines"></div>
            <div class="rgbd-hud-overlay">
                <div class="hud-crosshair-v"></div>
                <div class="hud-crosshair-h"></div>
                <div class="hud-box"></div>
                <span class="hud-tag top-left">FOV: 60°</span>
                <span class="hud-tag top-right">RES: 512x512</span>
                <span class="hud-tag bottom-left">TCP ALIGN</span>
                <span class="hud-tag bottom-right">Z-DIST: @tofLaserDist.ToString("F3")m</span>
            </div>
        </div>
    </div>
</div>

